{% block editorjs_widget %}
{% set editor_id = 'editorjs_' ~ id %}
<div data-pw-editor-widget="{{ editor_id }}">

<div class="pw-editor-modes" data-pw-editor-modes-for="{{ editor_id }}" role="group" aria-label="{{ 'editorEditingTools'|trans }}">
    <button type="button" class="pw-editor-mode" data-pw-editor-mode="json" aria-pressed="false" title="{{ 'editorSourceJson'|trans }}" aria-label="{{ 'editorSourceJson'|trans }}">
        {{ svg('code') }}
        <span>JSON</span>
    </button>
    <button type="button" class="pw-editor-mode" data-pw-editor-mode="markdown" aria-pressed="false" title="{{ 'editorSourceMarkdown'|trans }} (Ctrl + U)" aria-label="{{ 'editorSourceMarkdown'|trans }}" aria-keyshortcuts="Control+U">
        {{ svg('markdown') }}
        <span>Markdown</span>
    </button>
    <button type="button" class="pw-editor-mode" data-pw-copy-markdown data-copied="{{ 'editorCopied'|trans }}" data-copy-label="{{ 'editorCopy'|trans }}" data-copy-status="{{ 'editorMarkdownCopied'|trans }}" title="{{ 'editorCopyMarkdown'|trans }}" aria-label="{{ 'editorCopyMarkdown'|trans }}">
        {{ svg('copy') }}
        <span data-pw-copy-label>{{ 'editorCopy'|trans }}</span>
    </button>
    <span class="visually-hidden" role="status" data-pw-copy-status></span>
</div>
<div style="padding:10px 10px 0;">
    <textarea style="display:none" data-editorjs="{{ editor_id }}" {{ block('widget_attributes') }}>{{ value }}</textarea>
    <div id="{{ editor_id }}" data-input-id="{{ id }}" class="editorjs-holder"></div>

    {# Hidden media pickers the EditorJS image / gallery / attaches tools look up
       globally (select[id*="inline_image"] / [id*="inline_attaches"]). Rendered
       inside the widget so the block editor is self-contained on any form.
       admin.mediaPicker.js enhances each [data-pw-media-picker] into a full picker. #}
    <div class="d-none" aria-hidden="true">
      <select id="{{ editor_id }}_inline_image"{% for name, attrValue in editorjs_media_picker_attributes('inline_image', {mimeType: {comparison: '=', value: ['image/jpeg', 'image/png', 'image/gif', 'image/webp']}}) %} {{ name }}="{{ attrValue }}"{% endfor %}>
        <option value=""> </option>
      </select>
      <select id="{{ editor_id }}_inline_attaches"{% for name, attrValue in editorjs_media_picker_attributes('inline_attaches') %} {{ name }}="{{ attrValue }}"{% endfor %}>
        <option value=""> </option>
      </select>
    </div>
</div>
<div class="pw-editor-diagnostics" data-pw-diagnostics-for="{{ editor_id }}" hidden>
    <p class="mb-1" role="alert" data-pw-editor-error hidden></p>
    <details>
        <summary>{{ 'editorReportProblem'|trans }}</summary>
        <p class="text-muted my-2">{{ 'editorDiagnosticHelp'|trans }}</p>
        <label class="pw-editor-suggestions mb-2" for="{{ editor_id }}_writingSuggestions">
            <input type="checkbox" id="{{ editor_id }}_writingSuggestions" data-pw-writing-suggestions>
            {{ 'editorDisableWritingSuggestions'|trans }}
        </label>
        <button type="button" class="btn btn-secondary btn-sm" data-pw-download-diagnostic>{{ 'editorDownloadDiagnostic'|trans }}</button>
    </details>
</div>
<script data-pw-editorjs-config="{{ editor_id }}">
(function () {
window.pageLinkList = {{ editorjs_page_links(attr.page_host|default(''))|json_encode|raw }};
// Keep the URI list available to page-list tools and custom integrations.
window.pagesUriList = window.pageLinkList.map(page => page.uri);

{% block editorjs_config %}
var editorjsConfig = {
    name: "default",
    initialBlock: "paragraph",
    placeholder: "{{ 'editorParagraphPlaceholder'|trans|e('js') }}",
    i18n: { messages: {{ editorjs_i18n_messages()|json_encode|raw }} },
    diagnostics: {
        version: {{ editorjs_version|default('unknown')|json_encode|raw }},
        labels: { failure: "{{ 'editorDiagnosticFailure'|trans|e('js') }}" },
    },
    outline: {
        labels: {
            closeOutline: "{{ 'editorOutlineClose'|trans|e('js') }}",
            deleteBlock: "{{ 'editorOutlineDeleteBlock'|trans|e('js') }}",
            deleteGroup: "{{ 'editorOutlineDeleteGroup'|trans|e('js') }}",
            deleteHeading: "{{ 'editorOutlineDeleteHeading'|trans|e('js') }}",
            deleteSection: "{{ 'editorOutlineDeleteSection'|trans|e('js') }}",
            moveBlock: "{{ 'editorOutlineMoveBlock'|trans|e('js') }}",
            moveGroup: "{{ 'editorOutlineMoveGroup'|trans|e('js') }}",
            moveHeading: "{{ 'editorOutlineMoveHeading'|trans|e('js') }}",
            moveSection: "{{ 'editorOutlineMoveSection'|trans|e('js') }}",
            outline: "{{ 'editorOutline'|trans|e('js') }}",
            toggleSection: "{{ 'editorCollapse'|trans|e('js') }}",
        },
    },
    tools: {
        header: {
            name: "header",
            className: "Header",
            inlineToolbar: ['bold', 'italic', 'inline-code', 'marker', 'link', 'Strikethrough', 'small'],
            tunes: ['anchor', 'class', 'textAlign'],
            config: {
                placeholder: "{{ 'editorHeading'|trans|e('js') }}",
                levels: [2, 3, 4, 5, 6],
                defaultLevel: 2,
            },
        },
        list: {
            name: "list",
            className: "List",
            inlineToolbar: true,
            tunes: ['anchor'],
        },
        image: {
            name: "image",
            className: "Image",
            tunes: ['linkTune'],
            config: {
                endpoints: {
                    byFile: "/admin/media/block",
                    byUrl: "/admin/media/block",
                },
                onSelectFile: window.editorJsHelper.onSelectImage,
                onUploadFile: window.editorJsHelper.onUploadInline,
            },
            conversion: false,
        },
        gallery: {
            name: "gallery",
            className: "Gallery",
            tunes: ['clickableTune'],
            config: {
                endpoints: {
                    byFile: "/admin/media/block",
                    byUrl: "/admin/media/block",
                },
                onSelectFile: window.editorJsHelper.onSelectImage,
                onUploadFile: window.editorJsHelper.onUploadImage,
                onMultiSelectFile: window.editorJsHelper.onMultiSelectImage,
            }
        },
        embed: {
            name: "embed",
            className: "Embed",
            config: {
                onSelectFile: window.editorJsHelper.onSelectImage,
                onUploadFile: window.editorJsHelper.onUploadImage,
            },
        },
        delimiter: {
            name: "delimiter",
            className: "Delimiter",
        },
        groupStart: {
            name: "groupStart",
            className: "GroupStart",
        },
        groupEnd: {
            name: "groupEnd",
            className: "GroupEnd",
        },
        {# Before quote: both claim a `> ` chunk on import, and the first match wins. #}
        notice: {
            name: "notice",
            className: "Notice",
            tunes: ['anchor', 'class'],
            inlineToolbar: true,
        },
        quote: {
            name: "quote",
            className: "Quote",
            tunes: ['anchor'],
            inlineToolbar: true,
            config: {
                quotePlaceholder: "{{ 'editorQuote'|trans|e('js') }}",
                captionPlaceholder: "{{ 'editorQuoteAuthor'|trans|e('js') }}",
            },
        },
        table: {
            name: "table",
            className: "Table",
        },
        attaches: {
            name: "attaches",
            className: "Attaches",
            tunes: ['anchor'],
            config: {
                onSelectFile: window.editorJsHelper.onSelectFile,
                onUploadFile: window.editorJsHelper.onUploadInline,
            },
        },
        pages_list: {
            name: "pages_list",
            className: "PagesList",
            config: {
                preview: "/admin/page/block/{{ attr.page_id }}",
                {# Site display variants (custom property `pages_list_displays`),
                   rendered by /component/pages_list_<name>.html.twig. #}
                displays: {{ apps.get(attr.page_host|default('')).get('pages_list_displays')|default([])|json_encode|raw }},
            },
            tunes: ['anchor', 'class']
        },
        card_list: {
            name: "card_list",
            className: "CardList",
            inlineToolbar: true,
            tunes: ['anchor', 'class']
        },
        codeBlock: {
            name: "codeBlock",
            className: "CodeBlock",
            config: { mermaidUrl: {{ versionedAsset('/bundles/pushwordcore/mermaid/mermaid.js', true)|json_encode|raw }} },
            tunes: ['anchor'],
        },
        paragraph: {
            name: "paragraph",
            className: "Paragraph",
            tunes: ['anchor', 'class', 'textAlign'],
        },
        raw: {
            name: "raw",
            className: "Raw",
            config: {
                placeholder: "<div>...</div>",
                defaultHeight: "50"
            },
        },

        /** Inline Tool */

        "inline-code": {
            name: "inline-code",
            className: "InlineCode",
        },
        marker: {
            name: "marker",
            className: "Marker",
        },
        bold: {
            name: "bold",
            className: "Bold",
        },
        italic: {
            name: "italic",
            className: "Italic",
        },
        small: {
            name: "small",
            className: "Small",
        },
        link: {
            name: "link",
            className: "Hyperlink",
            config: {
                availableDesigns: {
                    Button: 'link-btn',
                    'Button outline': 'link-btn-outline',
                    Discreet: 'ninja',
                },
            }
        },
        underline: {
            name: "underline",
            className: "Underline",
        },
        Strikethrough: {
            name: "Strikethrough",
            className: "Strikethrough",
        },

        /** Tune */
        linkTune: {
            className: "HyperlinkTune",
        },
        clickableTune: {
            className: "ClickableTune",
        },
        anchor: {
            className: "AnchorTune",
        },
        class: {
            className: "ClassTune",
        },
        textAlign: {
            className: "AlignementTune",
        }
        {% block editorjs_block_to_add_new_plugin %}{% endblock %}
    },
    data: {},
    logLevel: "ERROR",
    holder: "{{ editor_id }}",
};

// Tools contributed by other bundles (e.g. snippet) via EditorJsToolProviderInterface.
Object.assign(editorjsConfig.tools, {{ editorjs_extra_tools(attr.page_host|default(''))|json_encode|raw }});
{% endblock %}

window.editorjsConfigs = window.editorjsConfigs || {};
window.editorjsConfigs[editorjsConfig.holder] = editorjsConfig;
window.editorjsConfig = editorjsConfig;
})();
    </script>

</div>

{% endblock %}
