.tc-popover {
  /* --color-border is inherited from .tc-wrap so the menu border matches the
     table; the background stays white on purpose, since this is a floating menu. */
  --color-background: #fff;
  --color-background-hover: rgba(232, 232, 235, 0.49);
  --color-background-confirm: #b91c1c;
  --color-background-confirm-hover: #991b1b;
  --color-text-confirm: #fff;
  --popover-shadow: var(--pw-elevation-3, 0 8px 24px #0f172a24);

  background: var(--color-background);
  border: 1px solid var(--color-border);
  box-shadow: var(--popover-shadow);
  border-radius: 6px;
  padding: 6px;
  display: none;
  width: 248px;
  max-width: calc(100vw - 2rem);
  max-height: min(440px, 70dvh);
  overflow-y: auto;
  box-sizing: border-box;
  will-change: opacity;

  &--opened {
    display: block;
    animation: menuShowing 100ms cubic-bezier(0.215, 0.61, 0.355, 1) forwards;
  }


  &__item {
    display: flex;
    width: 100%;
    min-height: 36px;
    border: 0;
    background: transparent;
    color: #1e293b;
    font-family: inherit;
    text-align: left;
    align-items: center;
    padding: 2px 14px 2px 2px;
    border-radius: 5px;
    cursor: pointer;
    white-space: normal;
    user-select: none;

    &:hover {
      background: var(--color-background-hover);
    }

    &:focus-visible {
      outline: 2px solid var(--focus-ring-color, #0284c7);
      outline-offset: -2px;
      background: var(--color-background-hover);
    }

    &--separated,
    &--destructive {
      margin-top: 6px;
      border-top: 1px solid var(--color-border);
    }

    &--destructive {
      color: #b91c1c;
    }

    &--active {
      color: #0369a1;
      background: #e0f2fe;
      box-shadow: inset 0 0 0 1px #7dd3fc;
    }

    &:not(:last-of-type){
      margin-bottom: 2px;
    }

    &-icon {
      display: inline-flex;
      width: 26px;
      height: 26px;
      align-items: center;
      justify-content: center;
      background: var(--color-background);
      border-radius: 5px;
      border: 1px solid var(--color-border);
      margin-right: 8px;
      flex-shrink: 0;
    }

    &-label {
      line-height: 22px;
      font-size: 14px;
      font-weight: 500;
    }

    &--confirm {
      background: var(--color-background-confirm);
      color: var(--color-text-confirm);

      &:hover,
      &:focus-visible {
        background-color: var(--color-background-confirm-hover);
      }
    }

    &--confirm &-icon {
      background: var(--color-background-confirm);
      border-color: rgba(0,0,0,0.1);

      svg {
        transition: transform 200ms ease-in;
        transform: rotate(90deg) scale(1.2);
      }
    }

    &--hidden {
      display: none;
    }
  }
}

@media (max-width: 650px) {
  .tc-toolbox .tc-popover {
    position: fixed;
    inset: auto 1rem 1rem !important;
    width: auto;
    translate: none !important;
  }

  .tc-popover__item {
    min-height: 44px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .tc-popover--opened,
  .tc-popover__item--confirm .tc-popover__item-icon svg {
    animation: none;
    transition: none;
  }
}

@keyframes menuShowing {
  0% {
    opacity:0;
  }
  to {
    opacity:1;
  }
}
