{
  "name": "pushword/admin",
  "type": "symfony-bundle",
  "description": "Default Admin to manage online Pushword App and websites.",
  "keywords": ["admin", "back-office", "easyadmin", "crud", "cms", "symfony", "pushword"],
  "homepage": "https://pushword.piedweb.com/extension/admin",
  "license": "MIT",
  "support": {
    "issues": "https://github.com/Pushword/Pushword/issues",
    "source": "https://github.com/Pushword/Pushword/tree/main/packages/admin",
    "docs": "https://pushword.piedweb.com/extension/admin"
  },
  "require": {
    "pushword/core": "*",
    "easycorp/easyadmin-bundle": "^5",
    "symfony/ux-twig-component": "^2.35 || ^3.0",
    "twig/extra-bundle": "^3"
  },
  "extra": {
    "branch-alias": {
      "dev-main": "1.0.x-dev"
    }
  },
  "autoload": {
    "psr-4": {
      "Pushword\\Admin\\": "src"
    }
  },
  "authors": [
    {
      "name": "Robin@PiedWeb",
      "email": "contact@piedweb.com",
      "homepage": "https://piedweb.com"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "symfony/runtime": true
    }
  }
}
