<div class="pw-draft-toggle d-flex align-items-center gap-2">
  <span class="ea-switch" id="pw-draft-toggle-wrapper">
    <input
      type="checkbox"
      role="switch"
      class="ea-switch-input"
      id="pw-draft-toggle-switch"
      data-target-input="Page_publishedAt"
    >
    <span class="ea-switch-track" aria-hidden="true"><span class="ea-switch-thumb"></span></span>
  </span>
  <small class="text-muted mb-0" id="pw-draft-toggle-status">
    —
  </small>
  <button type="button" class="btn btn-sm btn-outline-secondary px-1" id="pw-schedule-btn" title="{{ 'adminSchedule'|trans }}">
    <i class="fa fa-clock"></i>
  </button>
</div>

<script>
(function() {
  'use strict';

  {# The admin is translated; formatting dates against a hardcoded locale showed
     French dates to every other language. #}
  const adminLocale = '{{ app.request.locale|e('js') }}';
  {# The input holds the editorial clock (the form's view_timezone), not the browser's. #}
  const editorialTimezone = '{{ editorial_timezone.timezone.name|e('js') }}';

  const toggleSwitch = document.getElementById('pw-draft-toggle-switch');
  const toggleWrapper = document.getElementById('pw-draft-toggle-wrapper');
  const targetInputSelector = toggleSwitch?.getAttribute('data-target-input');
  const targetInput = targetInputSelector ? document.getElementById(targetInputSelector) : null;
  const scheduleBtn = document.getElementById('pw-schedule-btn');

  if (!toggleSwitch || !targetInput) {
    return;
  }

  const statusText = document.getElementById('pw-draft-toggle-status');

  /**
   * A moment on the editorial clock, in datetime-local format (YYYY-MM-DDTHH:mm)
   */
  function editorialDateTimeLocal(date) {
    const parts = {};
    new Intl.DateTimeFormat('en-CA', {
      timeZone: editorialTimezone,
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
      hour: '2-digit',
      minute: '2-digit',
      hourCycle: 'h23'
    }).formatToParts(date).forEach((part) => { parts[part.type] = part.value; });
    return `${parts.year}-${parts.month}-${parts.day}T${parts.hour}:${parts.minute}`;
  }

  /**
   * Update toggle color class based on scheduled vs published
   */
  function updateToggleColor() {
    if (!toggleWrapper) return;

    toggleWrapper.classList.remove('ea-switch-success', 'ea-switch-warning');

    if (!toggleSwitch.checked) return;

    // Both sides are editorial wall clocks in the same format: they compare as strings.
    if (targetInput.value > editorialDateTimeLocal(new Date())) {
      toggleWrapper.classList.add('ea-switch-warning');
    } else {
      toggleWrapper.classList.add('ea-switch-success');
    }
  }

  function updateToggleState() {
    const hasValue = targetInput.value.trim() !== '';
    toggleSwitch.checked = hasValue;

    if (statusText) {
      statusText.textContent = hasValue
        ? new Date(targetInput.value).toLocaleString(adminLocale, {
            year: 'numeric',
            month: '2-digit',
            day: '2-digit',
            hour: '2-digit',
            minute: '2-digit'
          })
        : '—';
    }

    updateToggleColor();
  }

  function handleToggleChange() {
    targetInput.value = toggleSwitch.checked ? editorialDateTimeLocal(new Date()) : '';
    updateToggleState();
    targetInput.dispatchEvent(new Event('change', { bubbles: true }));
  }

  function handleScheduleClick() {
    // Tomorrow 09:00 on the editorial calendar, counted in UTC so no browser DST change shifts the day.
    const tomorrow = new Date(editorialDateTimeLocal(new Date()).slice(0, 10) + 'T00:00:00Z');
    tomorrow.setUTCDate(tomorrow.getUTCDate() + 1);
    targetInput.value = tomorrow.toISOString().slice(0, 10) + 'T09:00';
    updateToggleState();
    targetInput.focus();
    targetInput.dispatchEvent(new Event('change', { bubbles: true }));
  }

  // Initialize toggle state
  updateToggleState();

  // Listen to toggle changes
  toggleSwitch.addEventListener('change', handleToggleChange);

  // Listen to schedule button
  if (scheduleBtn) {
    scheduleBtn.addEventListener('click', handleScheduleClick);
  }

  // Listen to target input changes (in case user manually changes the datetime)
  targetInput.addEventListener('change', updateToggleState);
  targetInput.addEventListener('input', updateToggleState);
})();
</script>
