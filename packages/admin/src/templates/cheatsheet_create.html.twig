{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}{{ 'adminLabelCheatsheet'|trans }}{% endblock %}

{% block main %}
    <div class="pw-empty-state">
        <i class="fa fa-book pw-empty-state__icon" aria-hidden="true"></i>
        <p class="pw-empty-state__title">{{ 'adminCheatsheetEmptyTitle'|trans }}</p>
        <p class="pw-empty-state__hint">{{ 'adminCheatsheetEmptyHint'|trans }}</p>
        <form method="post" action="{{ path('cheatsheetEditRoute') }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('create_cheatsheet') }}">
            <button type="submit" class="btn btn-primary">{{ 'adminCheatsheetCreate'|trans }}</button>
        </form>
    </div>
{% endblock %}
