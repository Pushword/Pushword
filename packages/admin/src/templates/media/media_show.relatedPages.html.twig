{% if related_pages %}
{% set sourceLabels = {
    content: 'adminMediaUsageSourceContent',
    main_image: 'adminMediaUsageSourceMainImage',
    property: 'adminMediaUsageSourceProperty',
} %}
<ul>
    {% for related_page in related_pages %}
        {% block item3 %}
            <li>
                <a href="{{ path('admin_page_edit', {id: related_page.id}) }}">
                    {{ pw(related_page).h1|raw }}
                </a>
                {% for source in usage_sources[related_page.id]|default([]) %}
                    <span class="badge badge-secondary">{{ sourceLabels[source]|default(source)|trans }}</span>
                {% endfor %}
            </li>
        {% endblock %}
    {% endfor %}
</ul>

{% if page_tags|default([]) is not empty %}
    <p class="text-muted mb-0">
        {{ 'adminMediaPageTagsLabel'|trans }} : {{ page_tags|join(' ') }}
    </p>
{% endif %}
{% endif %}
