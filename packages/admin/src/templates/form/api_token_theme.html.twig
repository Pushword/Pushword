{% block api_token_widget %}
  {% set initial_token = value|default('') %}
  {% set attr = attr|merge({placeholder: 'adminUserApiTokenPlaceholder'|trans}) %}

  <div class="pw-api-token" id="{{ id }}_container" data-api-token-widget
       data-regenerate-confirm="{{ 'adminUserApiTokenRegenerateConfirm'|trans }}"
       data-revoke-confirm="{{ 'adminUserApiTokenRevokeConfirm'|trans }}"
       data-copied-label="{{ 'adminUserApiTokenCopied'|trans }}">
    <input type="text" {{ block('widget_attributes') }} value="{{ initial_token }}">
    <div class="pw-api-token__actions">
      <button type="button" class="btn btn-outline-secondary" id="{{ id }}_generate"
              data-token-action="generate"{% if initial_token %} hidden{% endif %}>
        <i class="fa fa-key" aria-hidden="true"></i> {{ 'adminUserApiTokenGenerate'|trans }}
      </button>
      <button type="button" class="btn btn-outline-secondary" id="{{ id }}_copy"
              data-token-action="copy"{% if not initial_token %} hidden{% endif %}>
        <i class="fa fa-copy" aria-hidden="true"></i> <span>{{ 'adminUserApiTokenCopy'|trans }}</span>
      </button>
      <button type="button" class="btn btn-outline-secondary" id="{{ id }}_regenerate"
              data-token-action="regenerate"{% if not initial_token %} hidden{% endif %}>
        <i class="fa fa-refresh" aria-hidden="true"></i> {{ 'adminUserApiTokenRegenerate'|trans }}
      </button>
      <button type="button" class="btn pw-action-delete" id="{{ id }}_revoke"
              data-token-action="revoke"{% if not initial_token %} hidden{% endif %}>
        <i class="fa fa-times" aria-hidden="true"></i> {{ 'adminUserApiTokenRevoke'|trans }}
      </button>
    </div>
  </div>
{% endblock %}
