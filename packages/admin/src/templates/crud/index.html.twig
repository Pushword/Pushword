{% extends '@EasyAdmin/crud/index.html.twig' %}

{% block main %}
  <div class="d-flex justify-content-end mb-2">
    {% if pageSizeOptions is defined %}
      {{ include('@pwAdmin/components/page_size_selector.html.twig', {
        pageSizeOptions: pageSizeOptions,
        currentPageSize: currentPageSize,
      }) }}
    {% endif %}
  </div>

  {{ parent() }}
{% endblock %}

{# EasyAdmin answers an empty list with one line of text between two hairlines, plus
   14 skeleton rows that admin.css then has to hide. An empty list is where a user
   most needs direction, so say which of the two situations they are in and offer the
   way out of it. #}
{% block table_body_empty %}
  <tr class="no-results">
    <td colspan="100">
      {{ include('@pwAdmin/components/empty_state.html.twig') }}
    </td>
  </tr>
{% endblock %}
