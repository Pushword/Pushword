#!/bin/bash

# Obsolete. `vendor/pushword/core/install.php` — run by the Composer post-update and
# post-autoload hooks — does everything this script used to, without prompting.
#
# It ran from `post-install-cmd`, which `composer create-project` never fires, so on the
# documented install path it was dead code. On the *second* `composer install` it did
# fire, truncating config/routes.yaml, overwriting config/packages/pushword.yaml and
# blocking forever on a `read` prompt that no terminal was attached to.
#
# The file stays as a no-op because projects created before rc828 still carry the line
# in their composer.json. It now only unhooks itself, so the next `composer install`
# cleans it up for good.

echo "~ pushword/installer: this script is obsolete, vendor/pushword/core/install.php replaces it."

php -r "
\$json = json_decode(file_get_contents('composer.json'), true);
\$json['scripts']['post-install-cmd'] = array_values(array_filter(
    \$json['scripts']['post-install-cmd'] ?? [],
    fn(\$s) => !str_contains(\$s, 'vendor/pushword/installer/src/installer')
));
if (empty(\$json['scripts']['post-install-cmd'])) {
    unset(\$json['scripts']['post-install-cmd']);
}
file_put_contents('composer.json', json_encode(\$json, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . \"\n\");
"

echo "~ Removed it from composer.json > scripts > post-install-cmd."
