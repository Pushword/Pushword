{
  "name": "pushword/installer",
  "description": "Run the post-install scripts shipped by Pushword bundles when a Pushword app is installed or updated.",
  "keywords": ["installer", "symfony", "cms", "pushword"],
  "homepage": "https://pushword.piedweb.com",
  "license": "MIT",
  "support": {
    "issues": "https://github.com/Pushword/Pushword/issues",
    "source": "https://github.com/Pushword/Pushword/tree/main/packages/installer",
    "docs": "https://pushword.piedweb.com"
  },
  "require": {
    "pushword/core": "*",
    "symfony/filesystem": "^7.3 || ^8.0"
  },
  "extra": {
    "branch-alias": {
      "dev-main": "1.0.x-dev"
    }
  },
  "autoload": {
    "psr-4": {
      "Pushword\\Installer\\": "src"
    }
  },
  "require-dev": {
    "composer/composer": "*",
    "phpunit/phpunit": "*"
  },
  "authors": [
    {
      "name": "Robin@PiedWeb",
      "email": "contact@piedweb.com",
      "homepage": "https://piedweb.com"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true
}
