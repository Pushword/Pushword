{% extends '@EasyAdmin/page/content.html.twig' %}

{% set editLabel = (type == 'snippet' ? 'versionEditSnippet' : 'versionEditPage')|trans %}

{% block page_title %}{{ entity.slug }} › {{ 'versionVersions'|trans }}{% endblock %}

{% block page_actions %}
    {% if versions is not empty %}
    <a class="btn btn-secondary" href="{{ editUrl }}">
        <i class="fa fa-pen-to-square" aria-hidden="true"></i> {{ editLabel }}
    </a>
    {% endif %}
{% endblock %}

{% block content_title %}
    {{ 'versionVersions'|trans }}
    <span class="d-block small fw-normal text-body-secondary text-break mt-1">{{ entity.slug }}</span>
{% endblock %}

{% block main %}
{% if versions is empty %}
    <div class="card">
        <div class="card-body py-4 text-center">
            <p class="mb-3">{{ 'versionNoVersion'|trans }}</p>
            <a class="btn btn-primary" href="{{ editUrl }}">{{ editLabel }}</a>
        </div>
    </div>
{% else %}
<div class="card">
    <div class="card-body p-0 table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">{{ 'versionTitle'|trans }}</th>
                    <th scope="col" class="d-none d-lg-table-cell">{{ 'versionDate'|trans }}</th>
                    <th scope="col" class="d-none d-lg-table-cell">{{ 'versionEditor'|trans }}</th>
                    <th scope="col" class="d-none d-lg-table-cell">{{ 'versionReason'|trans }}</th>
                    <th scope="col" class="d-none d-lg-table-cell">{{ 'versionHold'|trans }}</th>
                    <th scope="col" class="text-end">{{ 'versionAction'|trans }}</th>
                </tr>
            </thead>
            <tbody>
            {% for version, v in versions|reverse(true) %}
                {% set compareUrl = path('admin_version_compare', {type: type, id: entity.id, versionLeft: version, versionRight: 'current'}) %}
                {% set editor = editors[version]|default('') %}
                {% set reason = attribute(v, 'editMessage')|default('') %}
                {% set isHeld = attribute(v, 'holdPublicationAt')|default(null) %}
                {% set date %}<span class="text-nowrap">#{{ loop.revindex }} ·</span> <time data-version-id="{{ version }}">{{ version|slice(0, 13) }}</time>{% endset %}
                {% set hold %}<span class="badge bg-warning text-dark">{{ 'versionHold'|trans }}</span>{% endset %}
                <tr>
                    <td class="text-break">
                        <a class="pw-list-title" href="{{ compareUrl }}">
                            {{ attribute(v, 'h1')|default('') ?: (attribute(v, 'title')|default('') ?: v.name|default(v.slug)) }}
                        </a>
                        <div class="d-lg-none text-body-secondary small mt-1">
                            <div>{{ date }}</div>
                            {% if editor %}<div>{{ editor }}</div>{% endif %}
                            {% if reason %}<div>{{ reason }}</div>{% endif %}
                            {% if isHeld %}<div class="mt-1">{{ hold }}</div>{% endif %}
                        </div>
                    </td>
                    <td class="d-none d-lg-table-cell text-body-secondary">{{ date }}</td>
                    <td class="d-none d-lg-table-cell text-body-secondary">{{ editor ?: '—' }}</td>
                    <td class="d-none d-lg-table-cell text-body-secondary">{{ reason ?: '—' }}</td>
                    <td class="d-none d-lg-table-cell text-body-secondary">{{ isHeld ? hold : '—' }}</td>
                    <td class="text-end">
                        <div class="d-flex flex-column flex-lg-row align-items-end justify-content-end gap-1 text-nowrap">
                            <a href="{{ compareUrl }}" class="btn btn-outline-primary btn-sm px-2">{{ 'versionCompare'|trans }}</a>
                            <form method="post" action="{{ path('admin_version_load', {type: type, id: entity.id, version: version}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('version_load_' ~ type ~ '_' ~ entity.id) }}">
                                <button type="submit" class="btn btn-outline-secondary btn-sm px-2">{{ 'versionRestore'|trans }}</button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endif %}
{% endblock %}

{% block body_javascript %}
{{ parent() }}
{{ include('@PushwordVersion/_version_date.html.twig') }}
<script>
  document.querySelectorAll('time[data-version-id]').forEach(function (el) {
    var id = el.dataset.versionId;
    el.textContent = window.pwVersionLabel(id);
    var sec = parseInt(id.slice(0, 8), 16);
    if (!Number.isNaN(sec)) el.dateTime = new Date(sec * 1000).toISOString();
  });
</script>
{% endblock %}
