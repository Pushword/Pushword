{
  "name": "pushword/version",
  "type": "symfony-bundle",
  "description": "Versioning pages with Pushword CMS.",
  "keywords": ["versioning", "revisions", "history", "cms", "pushword"],
  "homepage": "https://pushword.piedweb.com/extension/version",
  "license": "MIT",
  "support": {
    "issues": "https://github.com/Pushword/Pushword/issues",
    "source": "https://github.com/Pushword/Pushword/tree/main/packages/version",
    "docs": "https://pushword.piedweb.com/extension/version"
  },
  "require": {
    "pushword/core": "*",
    "symfony/serializer": "^8.0"
  },
  "extra": {
    "branch-alias": {
      "dev-main": "1.0.x-dev"
    }
  },
  "autoload": {
    "psr-4": {
      "Pushword\\Version\\": "src"
    }
  },
  "authors": [
    {
      "name": "Robin@PiedWeb",
      "email": "contact@piedweb.com",
      "homepage": "https://piedweb.com"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true
}
