{% import '@Pushword/component/context_help.html.twig' as contextHelp %}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Repurpose Studio · {{ post.page }}</title>
  <link rel="stylesheet" href="{{ versionedAsset('/bundles/pushwordcore/contextHelp.css') }}">
  <script type="module" src="{{ versionedAsset('/bundles/pushwordcore/contextHelp.js') }}"></script>
  <style>
    :root {
      color-scheme: light;
      --bg: #f4f5f7; --panel: #ffffff; --panel-2: #f8f9fa; --field: #ffffff;
      --line: #dee2e6; --line-2: #ced4da; --text: #212529; --muted: #626b73; --muted-2: #495057;
      --accent: #0d6efd; --accent-hover: #0b5ed7; --ok: #198754; --warn: #b45309; --bad: #dc3545;
    }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; background: var(--bg); color: var(--text); -webkit-font-smoothing: antialiased; }
    a { color: var(--accent); text-decoration: none; }
    a:hover { color: var(--accent-hover); }
    [x-cloak] { display: none !important; }

    header { display: flex; align-items: center; gap: 1rem; padding: .8rem 1.5rem; border-bottom: 1px solid var(--line); position: sticky; top: 0; background: color-mix(in srgb, var(--panel) 92%, transparent); backdrop-filter: blur(10px); z-index: 20; }
    .studio-context { display: flex; align-items: center; gap: 1rem; min-width: 0; }
    .studio-actions { display: flex; align-items: center; flex-wrap: wrap; gap: .6rem; min-width: 0; }
    .studio-exports { position: relative; }
    .studio-exports summary { list-style: none; }
    .studio-exports summary::-webkit-details-marker { display: none; }
    .studio-exports[open] summary { background: var(--panel-2); }
    .export-menu { position: absolute; top: calc(100% + .5rem); right: 0; display: grid; gap: .5rem; width: 17rem; padding: .75rem; border: 1px solid var(--line); border-radius: 8px; background: var(--panel); box-shadow: 0 8px 24px #0000001f; }
    .export-menu .btn { text-align: left; }
    .studio-actions { margin-left: auto; flex-shrink: 0; }
    header .back { font-size: .85rem; color: var(--muted-2); }
    header .back:hover { color: var(--accent); }
    header h1 { font-size: .95rem; font-weight: 600; margin: 0; letter-spacing: -.01em; white-space: nowrap; color: var(--text); }
    header .crumbs { min-width: 0; color: var(--muted); font-size: .8rem; font-variant-numeric: tabular-nums; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    header .back, header .badge { flex-shrink: 0; }

    .badge { font-size: .66rem; padding: .18rem .55rem; border-radius: 999px; border: 1px solid var(--line-2); text-transform: uppercase; letter-spacing: .06em; color: var(--muted-2); white-space: nowrap; }
    .badge.draft { color: var(--warn); border-color: #fde68a; background: #fef3c7; }
    .badge.planned { color: #084298; border-color: #bfdbfe; background: #dbeafe; }
    .badge.posted { color: #0f5132; border-color: #a7f3d0; background: #d1fae5; }

    .btn { border: 1px solid var(--line-2); border-radius: 8px; padding: .5rem .95rem; font-weight: 600; font-size: .82rem; cursor: pointer; background: var(--panel); color: var(--text); transition: border-color .15s, background .15s, opacity .15s; white-space: nowrap; }
    .btn:hover:not(:disabled) { border-color: var(--muted); background: var(--panel-2); }
    .btn:disabled { opacity: .55; cursor: default; }
    .btn.primary { background: var(--accent); color: #fff; border-color: transparent; }
    .btn.primary:hover:not(:disabled) { background: var(--accent-hover); }
    button:focus-visible, a:focus-visible, summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

    .toggle { display: inline-flex; border: 1px solid var(--line-2); border-radius: 8px; overflow: hidden; }
    .toggle button { background: var(--panel); color: var(--muted-2); border: 0; padding: .45rem .8rem; font-size: .8rem; font-weight: 600; cursor: pointer; }
    .toggle button.on { background: #e7f1ff; color: #084298; }
    .toggle button:focus-visible { outline-color: currentColor; outline-offset: -4px; }

    .layout { display: grid; grid-template-columns: minmax(0, 1fr) 28rem; gap: 1.5rem; padding: 1.5rem; align-items: start; }
    .layout > * { min-width: 0; }
    .studio-target { grid-column: 1 / -1; display: flex; align-items: end; gap: 1rem; }
    .studio-target .field { width: 16rem; max-width: 100%; }
    .studio-target label { font-size: .875rem; font-weight: 600; }

    .deck-wrap { min-width: 0; position: sticky; top: 4.75rem; }
    .preview-toolbar { display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem; }
    .video-preview { display: grid; justify-items: center; gap: .75rem; padding: 1rem; background: var(--panel); border: 1px solid var(--line); border-radius: 8px; }
    .video-preview video { display: block; max-width: 100%; max-height: 68vh; border-radius: 4px; background: var(--text); }
    .video-preview p { max-width: 38rem; margin: 0; color: var(--muted-2); font-size: .85rem; text-align: center; }
    .video-preview .video-error { color: var(--bad); }
    .video-preview .media-picker__actions { flex-wrap: wrap; justify-content: center; }
    .field-label { font-size: .75rem; font-weight: 600; }
    .video-filename { overflow-wrap: anywhere; font-size: .75rem; color: var(--muted-2); }
    .audio-panel > summary { list-style: none; }
    .audio-panel > summary::-webkit-details-marker { display: none; }
    .audio-panel[open] > summary .chev { transform: rotate(90deg); }
    .audio-summary__state { margin-left: auto; font-size: .75rem; color: var(--muted); }
    .audio-fields { display: grid; gap: 1.5rem; padding: .5rem 0 1rem; }
    .audio-track { border: 0; padding: 0; margin: 0; min-width: 0; }
    .audio-track legend { padding: 0; margin-bottom: .5rem; font-size: .875rem; font-weight: 600; }
    .audio-track__body, .audio-settings { display: grid; gap: 1rem; }
    .audio-source__name { margin: 0 0 .25rem; overflow-wrap: anywhere; font-size: .875rem; line-height: 1.5; }
    .audio-note { display: block; color: var(--muted-2); font-size: .8125rem; line-height: 1.5; margin: 0; }
    .audio-source .media-picker__actions { margin-top: .75rem; flex-wrap: wrap; }
    .field.audio-level { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: baseline; }
    .audio-level input, .audio-level .audio-error { grid-column: 1 / -1; }
    .audio-level__value { font-size: .875rem; font-weight: 600; font-variant-numeric: tabular-nums; }
    .media-picker__actions .audio-remove { border-color: transparent; background: transparent; font-weight: 400; }
    .media-picker__actions .audio-remove:hover { border-color: transparent; text-decoration: underline; }
    .audio-ducking { display: flex; align-items: flex-start; gap: .75rem; cursor: pointer; }
    .audio-ducking input { flex: 0 0 auto; width: 1.125rem; height: 1.125rem; margin: .125rem 0; accent-color: var(--accent); }
    .audio-ducking strong { display: block; font-size: .875rem; font-weight: 600; line-height: 1.5; margin-bottom: .25rem; }
    .audio-export { display: grid; justify-items: start; gap: .75rem; border-top: 1px solid var(--line); padding-top: 1rem; }
    .audio-error { margin: .25rem 0 0; color: var(--bad); font-size: .8125rem; line-height: 1.5; }
    .audio-settings input[aria-invalid=true] { border-color: var(--bad); }
    .deck { display: flex; gap: 1.1rem; overflow-x: auto; padding: .25rem .25rem 1.25rem; scroll-snap-type: x mandatory; scrollbar-width: thin; scrollbar-color: var(--line-2) transparent; }
    .deck::-webkit-scrollbar { height: 9px; }
    .deck::-webkit-scrollbar-thumb { background: var(--line-2); border-radius: 999px; }
    .slide { flex: 0 0 auto; scroll-snap-align: start; }
    .slide figure { margin: 0; }
    .slide svg { display: block; width: var(--rp-slide-w, {{ feedWidth }}px); height: auto; border-radius: 14px; box-shadow: 0 6px 24px #0000001f; border: 1px solid var(--line); transition: transform .18s, box-shadow .18s; }
    .deck-note { display: flex; align-items: center; gap: .6rem; margin: .1rem 0 0 .25rem; font-size: .72rem; color: var(--muted); }
    .deck-note span { flex: 1; }
    .deck-note input[type=range] { width: 8rem; flex: 0 0 auto; }
    .slide figure:hover svg { transform: translateY(-3px); box-shadow: 0 12px 32px #0000002e; }
    .slide figcaption { text-align: center; color: var(--muted); font-size: .72rem; margin-top: .5rem; font-variant-numeric: tabular-nums; }
    /* Text blocks are click-to-edit and drag-to-move (the renderer tags them with
       data-rp-edit); dragging a stack field converts it into a free text box. */
    .slide svg g[data-rp-edit] { cursor: grab; touch-action: none; }
    .slide svg g[data-rp-edit]:hover { opacity: .82; }
    .slide svg g[data-rp-edit]:active { cursor: grabbing; }

    /* Floating inline text editor, opened by clicking a text block on a slide. */
    .text-pop { position: fixed; z-index: 60; width: 19rem; background: var(--panel); border: 1px solid var(--line-2); border-radius: 12px; box-shadow: 0 12px 40px #00000026; padding: .7rem; display: flex; flex-direction: column; gap: .35rem; }
    .text-pop label { font-size: .68rem; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }

    aside { background: var(--panel); border: 1px solid var(--line); border-radius: 4px; padding: 1.1rem; display: flex; flex-direction: column; gap: 1rem; box-shadow: 0 1px 3px #0000000d; }
    .panel-head { display: flex; align-items: center; justify-content: space-between; gap: .5rem; }
    .panel-head .live { display: inline-flex; align-items: center; gap: .4rem; font-size: .72rem; color: var(--muted-2); }
    .live::before { content: ""; width: 8px; height: 8px; border-radius: 999px; background: var(--muted); transition: background .2s, box-shadow .2s; }
    .live.ok::before { background: var(--ok); box-shadow: 0 0 0 3px #19875426; }
    .live.busy::before { background: var(--accent); box-shadow: 0 0 0 3px #0d6efd26; animation: pulse 1s ease-in-out infinite; }
    .live.bad::before { background: var(--bad); box-shadow: 0 0 0 3px #dc354526; }
    @keyframes pulse { 50% { opacity: .35; } }

    /* Sections pull back over the aside's padding and re-apply it, so a separator rule
       spans the whole panel — as the slide rows further down already do. */
    section.group { display: flex; flex-direction: column; gap: .7rem; margin: 0 -1.1rem; padding: 1.1rem 1.1rem 0; border-top: 1px solid var(--line); }
    section.group:first-of-type { padding-top: 0; border-top: 0; }
    section.group h2 { font-size: .68rem; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); margin: 0; }
    .deck-fields { display: flex; flex-direction: column; gap: 1rem; }
    .grid2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .6rem; }
    .field { display: flex; flex-direction: column; gap: .28rem; min-width: 0; }
    .field > label { font-size: .8125rem; line-height: 1.4; color: var(--muted-2); display: flex; justify-content: space-between; gap: .5rem; }
    .field > label .val { color: var(--muted); font-variant-numeric: tabular-nums; }
    .field.full { grid-column: 1 / -1; }

    input[type=text], input[type=number], input[type=datetime-local], textarea, select {
      width: 100%; background: var(--field); border: 1px solid var(--line-2); border-radius: 8px; padding: .42rem .55rem;
      color: var(--text); font-size: .875rem; font-family: inherit;
    }
    textarea { resize: vertical; min-height: 3.2rem; line-height: 1.45; }
    input:focus, textarea:focus, select:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px #0d6efd26; }
    input[type=range] { width: 100%; accent-color: var(--accent); }
    input[type=color] { width: 100%; height: 2rem; background: var(--field); border: 1px solid var(--line-2); border-radius: 8px; padding: 2px; cursor: pointer; }

    .switch { display: inline-flex; align-items: center; gap: .5rem; font-size: .78rem; color: var(--muted-2); cursor: pointer; }
    .switch input { width: 2.2rem; height: 1.2rem; accent-color: var(--accent); }

    /* Same trick one level down: the list pulls back over the section's padding and each
       row re-applies it, so an open slide's tint (and its drop indicator) reach the edges. */
    .slides-list { display: flex; flex-direction: column; margin: 0 -1.1rem; }
    .slide-item { border-top: 1px solid var(--line); padding: 0 1.1rem; }
    .slide-item:first-child { border-top: 0; }
    .slide-item.open { background: var(--panel-2); }
    .slide-item__head { display: flex; align-items: center; gap: .5rem; padding: .6rem 0; cursor: pointer; user-select: none; }
    .slide-item__head:hover .slide-item__title { color: var(--text); }
    .slide-item .chev { width: .85rem; color: var(--muted); font-size: .7rem; text-align: center; transition: transform .15s; }
    .slide-item__toggle { display: flex; align-items: center; gap: .5rem; flex: 1; min-width: 0; border: 0; background: none; padding: .25rem 0; text-align: left; cursor: pointer; font: inherit; }
    .slide-item__title { flex: 1; min-width: 0; font-size: .875rem; color: var(--muted-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .slide-item__head .sp { display: flex; gap: .3rem; }
    .slide-item__body { display: flex; flex-direction: column; gap: .65rem; padding: .1rem 0 1rem; }
    .icon-btn { background: var(--panel); border: 1px solid var(--line-2); color: var(--muted-2); border-radius: 7px; width: 1.7rem; height: 1.7rem; cursor: pointer; font-size: .8rem; line-height: 1; }
    .icon-btn:hover { color: var(--text); border-color: var(--muted); }
    .icon-btn.danger:hover { color: var(--bad); border-color: var(--bad); }

    .page-link { display: flex; gap: .4rem; align-items: center; }
    .page-link input { flex: 1; min-width: 0; }

    .media-picker { display: flex; gap: .65rem; align-items: center; }
    .media-picker__thumb { width: 3.4rem; height: 3.4rem; flex: 0 0 auto; border-radius: 8px; border: 1px solid var(--line-2); background: var(--panel-2) center / cover no-repeat; }
    .media-picker__meta { display: flex; flex-direction: column; gap: .4rem; min-width: 0; }
    .media-picker__name { font-size: .74rem; color: var(--muted-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .media-picker.is-empty .media-picker__name { color: var(--muted); font-style: italic; }
    .image-cell + .image-cell { margin-top: .55rem; padding-top: .55rem; border-top: 1px dashed var(--line-2); }
    .media-picker__actions { display: flex; gap: .35rem; }
    .btn-xs { border: 1px solid var(--line-2); background: var(--panel); color: var(--muted-2); border-radius: 6px; padding: .375rem .625rem; min-height: 32px; font-size: .8125rem; font-weight: 600; cursor: pointer; }
    .btn-xs:hover { border-color: var(--muted); color: var(--text); }
    .btn-xs.danger:hover { color: var(--bad); border-color: var(--bad); }

    .rp-modal { position: fixed; inset: 0; width: 100%; height: 100%; max-width: none; max-height: none; margin: 0; border: 0; color: var(--text); background: #0b1120b3; padding: 3vh 3vw; }
    .rp-modal[open] { display: flex; }
    .rp-modal__panel { display: flex; flex-direction: column; width: 100%; background: var(--panel); border-radius: 14px; overflow: hidden; box-shadow: 0 20px 60px #00000052; }
    .rp-modal__bar { display: flex; align-items: center; justify-content: space-between; padding: .55rem 1rem; border-bottom: 1px solid var(--line); font-size: .82rem; font-weight: 600; }
    .rp-modal__frame { flex: 1; width: 100%; border: 0; }

    .swatches { display: flex; gap: .4rem; }
    .swatch { flex: 1; }

    #rp-spec { width: 100%; min-height: 30rem; background: var(--panel-2); border: 1px solid var(--line-2); border-radius: 11px; padding: .8rem; font-family: ui-monospace, "SF Mono", Menlo, monospace; font-size: .74rem; line-height: 1.55; color: var(--text); resize: vertical; tab-size: 2; }
    #rp-spec:focus { outline: none; border-color: var(--accent); }

    .source-wrap { position: relative; min-height: 30rem; }

    ul.violations { list-style: none; margin: 0; padding: 0; font-size: .74rem; color: #842029; display: flex; flex-direction: column; gap: .3rem; }
    ul.violations li { padding: .4rem .55rem; border-radius: 8px; background: #f8d7da; border: 1px solid #f1aeb5; }
    ul.violations code { color: var(--bad); }

    .notice { display: flex; align-items: flex-start; gap: .5rem; font-size: .74rem; color: var(--warn); background: #fef3c7; border: 1px solid #fde68a; border-radius: 8px; padding: .55rem .65rem; line-height: 1.4; }
    .notice span { flex: 1; }
    .notice .icon-btn { flex: 0 0 auto; width: 1.5rem; height: 1.5rem; }

    .actions { display: flex; gap: .6rem; }
    .actions .btn { flex: 1; }

    /* Auto-growing textareas (caption, paragraph): grow with content, capped. */
    textarea.autogrow { field-sizing: content; min-height: 3.2rem; max-height: 15rem; resize: none; overflow-y: auto; }
    /* Single-line start for short fields (title, tagline) that accept explicit line breaks. */
    textarea.autogrow.one { min-height: 2.1rem; }

    /* One free-text box's controls, separated like image cells. */
    .free-text { padding-top: .55rem; border-top: 1px dashed var(--line-2); display: flex; flex-direction: column; gap: .55rem; }

    /* Collapsible group header (Deck). */
    .group-head { display: flex; align-items: center; gap: .45rem; width: 100%; border: 0; background: none; padding: .6rem 0; text-align: left; font: inherit; cursor: pointer; user-select: none; }
    .group-head .chev { width: .8rem; color: var(--muted); font-size: .7rem; text-align: center; }
    .group-head .group-title { font-size: .75rem; font-weight: 600; text-transform: uppercase; letter-spacing: .08em; color: var(--muted-2); }
    /* Open, it tints and bleeds like an open slide. The band carries the head and the
       several sub-grids the group holds, so it sits on the section itself. */
    section.group.open { padding-bottom: 1.1rem; background: var(--panel-2); }
    /* Head and first grid already sit .6rem apart; the group's gap would add to it. */
    section.group.open > .group-head { padding-bottom: .1rem; }

    /* Drag-to-reorder handle + drag states. */
    .grip { cursor: grab; background: none; border: 0; color: var(--muted); font-size: .95rem; line-height: 1; letter-spacing: -2px; padding: .25rem .15rem .25rem 0; }
    .grip:hover { color: var(--muted); }
    .grip:active { cursor: grabbing; }
    .slide-item.dragging { opacity: .4; }
    .slide-item.drag-over { box-shadow: inset 0 2px 0 var(--accent); }

    /* Colour field: preview square + hex, opening a swatch/custom popover. */
    .color-field { display: flex; align-items: center; gap: .5rem; width: 100%; background: var(--field); border: 1px solid var(--line-2); border-radius: 8px; padding: .3rem .45rem; cursor: pointer; font: inherit; color: var(--text); }
    .color-field:hover { border-color: var(--muted); }
    .sw { width: 1.15rem; height: 1.15rem; flex: 0 0 auto; border-radius: 5px; border: 1px solid #00000022;
      background-image: linear-gradient(45deg,#ccc 25%,transparent 25%,transparent 75%,#ccc 75%),linear-gradient(45deg,#ccc 25%,#fff 25%,#fff 75%,#ccc 75%);
      background-size: 10px 10px; background-position: 0 0, 5px 5px; }
    .color-field .hex { flex: 1; text-align: left; font-size: .76rem; font-variant-numeric: tabular-nums; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .color-field .hex.empty { color: var(--muted); font-style: italic; }
    .caret { color: var(--muted); font-size: .58rem; }

    .color-pop { position: fixed; z-index: 60; width: 15rem; background: var(--panel); border: 1px solid var(--line-2); border-radius: 12px; box-shadow: 0 12px 40px #00000026; padding: .7rem; display: flex; flex-direction: column; gap: .6rem; }
    .color-pop__top { display: flex; align-items: center; gap: .45rem; }
    .color-pop__top .sw { width: 1.7rem; height: 1.7rem; }
    .color-pop__top input[type=text] { padding: .3rem .45rem; font-family: ui-monospace, monospace; font-size: .76rem; }
    .color-pop__native { width: 2rem; height: 2rem; flex: 0 0 auto; padding: 2px; border: 1px solid var(--line-2); border-radius: 6px; background: var(--field); cursor: pointer; }
    .color-pop__clear { font-size: .68rem; color: var(--muted); background: none; border: 0; cursor: pointer; text-align: left; padding: 0; }
    .color-pop__clear:hover { color: var(--accent); }
    .tw-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 3px; max-height: 11rem; overflow-y: auto; }
    .tw-sw { width: 100%; aspect-ratio: 1; border-radius: 4px; border: 1px solid #0000001a; cursor: pointer; padding: 0; transition: transform .1s, box-shadow .1s; }
    .tw-sw:hover { transform: scale(1.18); box-shadow: 0 0 0 2px var(--accent); }
    .color-contrast { margin: 0; display: flex; justify-content: space-between; gap: .5rem; font-size: .7rem; font-variant-numeric: tabular-nums; padding: .28rem .45rem; border-radius: 7px; }
    .color-contrast.ok { color: #0f5132; background: #d1fae5; }
    .color-contrast.warn { color: var(--warn); background: #fef3c7; }
    .color-contrast.bad { color: #842029; background: #f8d7da; }
    .color-suggest { display: flex; align-items: center; gap: 3px; }
    .color-suggest .tw-sw { width: 1.15rem; height: 1.15rem; aspect-ratio: auto; flex: 0 0 auto; }
    .color-suggest__label { font-size: .64rem; color: var(--muted); margin-left: .2rem; }

    /* Fake-select trigger opening the background-effect modal. */
    .fake-select { display: flex; align-items: center; gap: .5rem; width: 100%; background: var(--field); border: 1px solid var(--line-2); border-radius: 8px; padding: .26rem .4rem; cursor: pointer; font: inherit; color: var(--text); }
    .fake-select:hover { border-color: var(--muted); }
    .fake-select .thumb { width: 1.7rem; height: 1.7rem; flex: 0 0 auto; border-radius: 5px; overflow: hidden; border: 1px solid var(--line); background: var(--panel-2); }
    .fake-select .lbl { flex: 1; text-align: left; font-size: .78rem; }
    .thumb svg { display: block; width: 100%; height: 100%; }

    /* Background-effect picker modal. */
    .effect-modal { align-items: center; justify-content: center; }
    .effect-modal .rp-modal__panel { width: 100%; max-width: 58rem; max-height: 82vh; }
    .effect-tabs { display: flex; gap: .3rem; padding: .65rem 1rem; border-bottom: 1px solid var(--line); flex-wrap: wrap; }
    .effect-tabs button { border: 0; background: var(--panel-2); color: var(--muted-2); border-radius: 999px; padding: .3rem .8rem; font-size: .74rem; font-weight: 600; cursor: pointer; }
    .effect-tabs button.on { background: color-mix(in srgb, var(--accent) 14%, transparent); color: var(--accent); }
    .effect-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; padding: 1.1rem; overflow-y: auto; }
    @media (max-width: 720px) { .effect-grid { grid-template-columns: repeat(2, 1fr); } }
    .effect-tile { border: 2px solid var(--line); border-radius: 12px; overflow: hidden; cursor: pointer; background: var(--panel-2); padding: 0; display: flex; flex-direction: column; transition: border-color .15s, transform .15s; }
    .effect-tile:hover { transform: translateY(-2px); border-color: var(--line-2); }
    .effect-tile.on { border-color: var(--accent); }
    .effect-tile .thumb { width: 100%; aspect-ratio: 4 / 5; background: var(--panel-2); }
    .effect-tile .name { padding: .5rem .6rem; font-size: .76rem; font-weight: 600; color: var(--muted-2); text-align: center; }
    .effect-tile.on .name { color: var(--accent); }

    @media (max-width: 1024px) {
      header { flex-wrap: wrap; }
      .studio-context { flex: 1 1 100%; }
      .layout { grid-template-columns: minmax(0, 1fr); }
      .deck-wrap { position: static; }
    }
    @media (max-width: 720px) {
      header { gap: .6rem; padding: .75rem 1rem; }
      .studio-context { gap: .6rem; }
      header .back { white-space: nowrap; }
      .studio-actions { width: 100%; }
      .studio-save { margin-left: auto; }
      .studio-exports { position: static; }
      .export-menu { right: 1rem; left: 1rem; width: auto; }
      .layout { gap: 1rem; padding: 1rem; }
      .studio-target { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; }
      .studio-target .field { width: auto; }
      .studio-target select { min-height: 44px; font-size: 1rem; }
      .audio-panel .btn, .audio-panel .btn-xs, .audio-panel > summary { min-height: 44px; }
      .audio-panel input[type=number] { min-height: 44px; font-size: 1rem; }
      .audio-panel input[type=range], .audio-ducking { min-height: 44px; }
      .deck-note { flex-wrap: wrap; }
      .deck-note span { flex-basis: 100%; }
    }
    @media (max-width: 480px) {
      .studio-target { grid-template-columns: minmax(0, 1fr); }
    }
    @media (pointer: coarse) {
      .btn, .btn-xs, .icon-btn, .toggle button, .slide-item__toggle, .grip, .group-head, header .back {
        min-height: 44px;
        min-width: 44px;
      }
      header .back { display: inline-flex; align-items: center; }
      input[type=text], input[type=number], input[type=datetime-local], textarea, select { min-height: 44px; font-size: 1rem; }
      input[type=range], input[type=color], .switch, .slide-item__head { min-height: 44px; }
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation: none !important; transition: none !important; }
      .slide figure:hover svg, .tw-sw:hover, .effect-tile:hover { transform: none; }
    }
  </style>
</head>
<body x-data="repurposeStudio()">
  <script>
    window.RP_STUDIO = {
      spec: {{ specJs|raw }},
      slides: {{ slidesJs|raw }},
      video: {{ videoJs|raw }},
      messages: {
        audioChooseMusic: {{ 'repurposeAudioChooseMusic'|trans|json_encode(constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }},
        audioChooseVoice: {{ 'repurposeAudioChooseVoice'|trans|json_encode(constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }},
        audioConfigured: {{ 'repurposeAudioConfigured'|trans|json_encode(constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }},
        audioDuckingHint: {{ 'repurposeAudioDuckingHint'|trans|json_encode(constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }},
        audioDuckingNeedsTracks: {{ 'repurposeAudioDuckingNeedsTracks'|trans|json_encode(constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }},
        audioEmpty: {{ 'repurposeAudioEmpty'|trans|json_encode(constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }},
        audioExport: {{ 'repurposeAudioExport'|trans|json_encode(constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }},
        audioReplace: {{ 'repurposeAudioReplace'|trans|json_encode(constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }},
        audioTitle: {{ 'repurposeAudioTitle'|trans|json_encode(constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }},
        audioInvalid: {{ 'repurposeAudioInvalid'|trans|json_encode(constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }},
        videoTitle: {{ 'repurposeVideoTitle'|trans|json_encode(constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }},
        videoInvalid: {{ 'repurposeVideoInvalid'|trans|json_encode(constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }}
      },
      vocab: {{ vocabJs|raw }},
      backgroundEffects: {{ backgroundEffectsJs|raw }},
      network: {{ carousel.network|json_encode|raw }},
      feedWidth: {{ feedWidth }},
      networkUrls: {{ networkUrlsJs|raw }},
      urls: {
        preview: {{ path('repurpose_studio_preview', {id: post.id})|json_encode|raw }},
        save: {{ path('repurpose_studio_save', {id: post.id})|json_encode|raw }},
        export: {{ path('repurpose_studio_export', {id: post.id})|json_encode|raw }},
        exportVideo: {{ path('repurpose_studio_export_video', {id: post.id})|json_encode|raw }},
        pinImage: {{ path('repurpose_studio_pin_image', {id: post.id})|json_encode|raw }},
        mediaIndex: {{ path('admin_media_index', {view: 'mosaic', pwMediaPicker: '1', pwMediaPickerFieldId: 'rp-media'})|json_encode|raw }},
        mediaUpload: {{ path('admin_media_new', {pwMediaPicker: '1', pwMediaPickerFieldId: 'rp-media'})|json_encode|raw }},
        mediaThumb: {{ path('pushword_media_cache', {filter: 'md', fileName: 'RPFILENAME'})|json_encode|raw }}
      },
      filename: {{ (post.page|replace({'/': '-'}) ~ '-' ~ carousel.network)|json_encode|raw }}
    }
  </script>

  <header>
    <div class="studio-context">
      <a class="back" href="{{ backUrl }}">← Back</a>
      <h1>Repurpose Studio</h1>
      <span class="crumbs"><span x-text="pageLabel"></span> · <span x-text="vocab.networkLabels[network]"></span></span>
      <span class="badge" :class="spec.status" x-text="spec.status"></span>
    </div>
    <div class="studio-actions">
      <div class="toggle" role="group" aria-label="Editor view">
        <button type="button" :class="view === 'visual' && 'on'" aria-pressed="true" :aria-pressed="view === 'visual'" aria-controls="rp-visual-editor" @click="setView('visual')">Visual</button>
        <button type="button" :class="view === 'source' && 'on'" aria-pressed="false" :aria-pressed="view === 'source'" aria-controls="rp-source-editor" @click="setView('source')">Source</button>
      </div>
      <details class="studio-exports" @click.outside="$el.open = false" @keydown.escape="if ($el.open) { $el.open = false; $el.querySelector('summary').focus() }">
        <summary class="btn">{{ 'repurposeExport'|trans }} ▾</summary>
        <div class="export-menu">
          <a class="btn" x-show="video" x-cloak :href="video ? video.url : null" download>{{ 'repurposeVideoDownload'|trans }}</a>
          <button class="btn" type="button" @click="exportZip()" :disabled="exporting" x-text="exportLabel">Export .zip</button>
          <button class="btn" type="button" @click="exportSvg()" :disabled="exportingSvg" x-text="exportSvgLabel">Export .svg</button>
          <button class="btn" type="button" @click="exportVideo()" :disabled="exportingVideo" x-text="exportVideoLabel">Slideshow .mp4</button>
          <button class="btn" type="button" x-show="network === 'pinterest'" x-cloak @click="pinToPinterest()" :disabled="pinning" x-text="pinLabel">📌 Pin to Pinterest</button>
        </div>
      </details>
      <button class="btn primary studio-save" type="button" @click="save()" :disabled="saving" x-text="saveLabel">Save</button>
    </div>
  </header>

  <div class="layout" @wheel="sliderWheel($event)">
    <section class="studio-target" aria-label="{{ 'repurposePublishingTarget'|trans }}">
      <div class="field">
        <label for="rp-network">{{ 'repurposeNetwork'|trans }}</label>
        <select id="rp-network" @change="switchNetwork($event)" x-init="$nextTick(() => $el.value = network)">
          <template x-for="n in vocab.networks" :key="n"><option :value="n" x-text="vocab.networkLabels[n]"></option></template>
        </select>
      </div>
      <div class="field">
        <label for="rp-format">{{ 'repurposeFormat'|trans }}</label>
        <select id="rp-format" x-model="spec.format" x-init="$nextTick(() => $el.value = spec.format)">
          <template x-for="f in vocab.formats" :key="f"><option :value="f" x-text="vocab.formatLabels[f]"></option></template>
        </select>
      </div>
    </section>
    <div class="deck-wrap" @wheel="deckZoomWheel($event)">
      <div class="preview-toolbar">
        <div class="toggle" role="group" aria-label="{{ 'repurposePreviewMode'|trans }}">
          <button type="button" :class="previewMode === 'slides' && 'on'" :aria-pressed="previewMode === 'slides'" aria-controls="rp-slide-preview" @click="previewMode = 'slides'">{{ 'repurposePreviewSlides'|trans }}</button>
          <button type="button" :class="previewMode === 'video' && 'on'" :aria-pressed="previewMode === 'video'" aria-controls="rp-video-preview" @click="previewMode = 'video'">{{ 'repurposeVideoTitle'|trans }}</button>
        </div>
      </div>
      <section id="rp-video-preview" x-show="previewMode === 'video'" x-cloak class="video-preview" aria-label="{{ 'repurposeVideoTitle'|trans }}">
        <template x-if="previewMode === 'video' && video">
          <video controls playsinline preload="metadata" :src="video.url" @error="videoError = true" aria-label="{{ 'repurposeVideoTitle'|trans }}"></video>
        </template>
        <p x-show="videoError" x-cloak class="video-error" role="status">{{ 'repurposeVideoError'|trans }}</p>
        <p x-show="!video && !selectedVideo">{{ 'repurposeVideoEmpty'|trans }}</p>
        <p x-show="!video && selectedVideo" class="video-error" role="status">{{ 'repurposeVideoMissing'|trans }}</p>
        <div class="media-picker__actions" x-show="!video" x-cloak>
          <button type="button" class="btn" @click="pickVideo('choose')">{{ 'repurposeVideoChoose'|trans }}</button>
          <button type="button" class="btn" @click="pickVideo('upload')">{{ 'repurposeVideoUpload'|trans }}</button>
        </div>
        <p x-show="video">{{ 'repurposeVideoRenderNote'|trans }}</p>
        <a x-show="video" :href="video ? video.url : null" download>{{ 'repurposeVideoDownload'|trans }}</a>
      </section>
      <div id="rp-slide-preview" x-show="previewMode === 'slides'">
        <div class="deck" :style="'--rp-slide-w:' + slideWidth + 'px'">
          <template x-for="(svg, i) in slides" :key="i">
            <div class="slide" @pointerenter="hoverSlide(i)" @pointerleave="hoverSlideLeave()">
              <figure>
                <div x-html="svg" @click="deckTextClick(i, $event)" @pointerdown="deckTextDown(i, $event)"></div>
                <figcaption>Slide <span x-text="i + 1"></span> / <span x-text="slides.length"></span></figcaption>
              </figure>
            </div>
          </template>
        </div>
        <p class="deck-note">
          <span x-text="deckNote">Slides at {{ feedWidth }}px — the typical {{ carousel.network }} mobile feed width.</span>
          {{ contextHelp.help('Preview zoom', 'repurposeHelpPreview'|trans) }}
          <input type="range" min="0.5" max="3" step="0.05" x-model.number="zoom" aria-label="Preview zoom" title="Preview zoom (or Ctrl+scroll over the deck) — inspection only, 100% is the real feed size">
          <button type="button" class="btn-xs" x-show="1 !== zoom" x-cloak @click="zoom = 1">100&nbsp;%</button>
        </p>
      </div>
    </div>

    <aside>
      <div class="panel-head">
        <strong style="font-size:.8rem;">Editor</strong>
        <span class="live" :class="live.state" x-text="live.text"></span>
      </div>

      <div class="notice" x-show="notice" x-cloak>
        <span x-text="notice"></span>
        <button type="button" class="icon-btn" @click="notice = ''" aria-label="Dismiss">✕</button>
      </div>

      <ul class="violations" x-show="violations.length" x-cloak>
        <template x-for="(v, i) in violations" :key="i">
          <li><code x-text="v.path || 'spec'"></code> — <span x-text="v.message"></span></li>
        </template>
      </ul>

      {# ---------- VISUAL EDITOR ---------- #}
      <div id="rp-visual-editor" role="region" aria-label="Visual editor" x-show="view === 'visual'" style="display:flex;flex-direction:column;gap:1rem;">
        <section class="group">
          <details class="audio-panel" id="rp-audio-fields" x-init="$el.open = !!(spec.audio.voice.media || spec.audio.music.media)">
            <summary class="group-head audio-summary">
              <span class="chev" aria-hidden="true">▸</span>
              <span class="group-title">{{ 'repurposeAudioTitle'|trans }}</span>
              <span class="audio-summary__state" x-text="spec.audio.voice.media || spec.audio.music.media ? messages.audioConfigured : messages.audioEmpty"></span>
            </summary>
            <div class="audio-fields">
              <p class="audio-note">{{ 'repurposeAudioIntro'|trans }}</p>
              {% for track, label in {voice: 'repurposeAudioVoice', music: 'repurposeAudioMusic'} %}
                <fieldset class="audio-track">
                  <legend>{{ label|trans }}</legend>
                  <div class="audio-track__body">
                    <div class="audio-source">
                      <p class="audio-source__name" x-text="spec.audio.{{ track }}.media || {{ (track == 'voice' ? 'repurposeAudioVoiceEmpty' : 'repurposeAudioMusicEmpty')|trans|json_encode }}"></p>
                      <p class="audio-note">{{ (track == 'voice' ? 'repurposeAudioVoiceHint' : 'repurposeAudioMusicHint')|trans }}</p>
                      <div class="media-picker__actions">
                        <button type="button" class="btn-xs" x-on:click="pickAudio('{{ track }}', 'choose')" aria-describedby="rp-{{ track }}-media-error" x-text="spec.audio.{{ track }}.media ? messages.audioReplace : messages.{{ track == 'voice' ? 'audioChooseVoice' : 'audioChooseMusic' }}"></button>
                        <button type="button" class="btn-xs" x-on:click="pickAudio('{{ track }}', 'upload')">{{ 'repurposeVideoUpload'|trans }}</button>
                        <button type="button" class="btn-xs audio-remove" x-show="spec.audio.{{ track }}.media" x-cloak x-on:click="spec.audio.{{ track }}.media = ''">{{ 'repurposeVideoRemove'|trans }}</button>
                      </div>
                      <p id="rp-{{ track }}-media-error" class="audio-error" x-show="audioError('{{ track }}', 'media')" x-cloak x-text="audioError('{{ track }}', 'media')"></p>
                    </div>
                    <div class="audio-settings" x-show="spec.audio.{{ track }}.media" x-cloak>
                      <div class="field audio-level">
                        <label for="rp-{{ track }}-volume">{{ 'repurposeAudioVolume'|trans }}</label>
                        <output class="audio-level__value" for="rp-{{ track }}-volume" aria-hidden="true" x-text="Math.round(spec.audio.{{ track }}.volume * 100) + ' %'"></output>
                        <input id="rp-{{ track }}-volume" type="range" min="0" max="1" step="0.01" x-model.number="spec.audio.{{ track }}.volume"
                               x-bind:aria-valuetext="Math.round(spec.audio.{{ track }}.volume * 100) + ' %'" x-bind:aria-invalid="!!audioError('{{ track }}', 'volume')" aria-describedby="rp-{{ track }}-volume-error">
                        <p id="rp-{{ track }}-volume-error" class="audio-error" x-show="audioError('{{ track }}', 'volume')" x-cloak x-text="audioError('{{ track }}', 'volume')"></p>
                      </div>
                      <div class="grid2">
                        {% for fade, fadeLabel in {fadeIn: 'repurposeAudioFadeIn', fadeOut: 'repurposeAudioFadeOut'} %}
                          <div class="field">
                            <label for="rp-{{ track }}-{{ fade }}">{{ fadeLabel|trans }}</label>
                            <input id="rp-{{ track }}-{{ fade }}" type="number" min="0" max="30" step="0.1" inputmode="decimal" x-model.number="spec.audio.{{ track }}.{{ fade }}"
                                   x-bind:aria-invalid="!!audioError('{{ track }}', '{{ fade }}')" aria-describedby="rp-{{ track }}-{{ fade }}-error">
                            <p id="rp-{{ track }}-{{ fade }}-error" class="audio-error" x-show="audioError('{{ track }}', '{{ fade }}')" x-cloak x-text="audioError('{{ track }}', '{{ fade }}')"></p>
                          </div>
                        {% endfor %}
                      </div>
                    </div>
                  </div>
                </fieldset>
              {% endfor %}
              <label class="audio-ducking" for="rp-audio-ducking">
                <input id="rp-audio-ducking" type="checkbox" x-model="spec.audio.ducking" x-bind:disabled="!spec.audio.voice.media || !spec.audio.music.media" aria-describedby="rp-audio-ducking-hint">
                <span>
                  <strong>{{ 'repurposeAudioDucking'|trans }}</strong>
                  <span id="rp-audio-ducking-hint" class="audio-note" x-text="spec.audio.voice.media && spec.audio.music.media ? messages.audioDuckingHint : messages.audioDuckingNeedsTracks"></span>
                </span>
              </label>
              <div class="audio-export">
                <p class="audio-note">{{ 'repurposeAudioExportNote'|trans }}</p>
                <button type="button" class="btn" x-show="spec.audio.voice.media || spec.audio.music.media" x-cloak x-on:click="exportVideo()" x-bind:disabled="exportingVideo" x-text="exportingVideo ? exportVideoLabel : messages.audioExport"></button>
              </div>
            </div>
          </details>
        </section>
        <section class="group" :class="{ 'open': deckOpen }">
          <button type="button" class="group-head" @click="toggleDeck()" :aria-expanded="deckOpen" aria-controls="rp-deck-fields">
            <span class="chev" aria-hidden="true" x-text="deckOpen ? '▾' : '▸'"></span>
            <span class="group-title">Deck</span>
          </button>
          <div id="rp-deck-fields" x-show="deckOpen" x-cloak class="deck-fields">
            <div class="grid2">
              <div class="field full">
                <span class="field-label">{{ 'repurposeVideoTitle'|trans }} · MP4 / WebM</span>
                <span class="video-filename" x-text="spec.video || '—'"></span>
                <div class="media-picker__actions">
                  <button type="button" class="btn-xs" @click="pickVideo('choose')">{{ 'repurposeVideoChoose'|trans }}</button>
                  <button type="button" class="btn-xs" @click="pickVideo('upload')">{{ 'repurposeVideoUpload'|trans }}</button>
                  <button type="button" class="btn-xs" x-show="spec.video" @click="clearVideo()">{{ 'repurposeVideoRemove'|trans }}</button>
                </div>
              </div>
              <div class="field full" x-id="['field']">
                <label :for="$id('field')">Page <span class="val" x-show="isStandalone" x-cloak>standalone — not linked</span></label>
                <div class="page-link">
                  <input type="text" x-model="pageField" list="rp-pages" placeholder="Standalone — type or pick a slug to link a page" :id="$id('field')">
                  <button type="button" class="btn-xs" @click="detachPage()" x-show="!isStandalone">Detach</button>
                </div>
                <datalist id="rp-pages">
                  {% for slug in pageSlugs %}<option value="{{ slug }}"></option>{% endfor %}
                </datalist>
              </div>
              <div class="field" x-id="['field']">
                <label :for="$id('field')">Status</label>
                <select x-model="spec.status" x-init="$nextTick(() => $el.value = spec.status)" :id="$id('field')">
                  <template x-for="s in vocab.statuses" :key="s"><option :value="s" x-text="s"></option></template>
                </select>
              </div>
              <div class="field" x-id="['field']">
                <label :for="$id('field')">Font pairing</label>
                <select x-model="spec.fontPairing" x-init="$nextTick(() => $el.value = spec.fontPairing)" :id="$id('field')">
                  <option value="">— inherit —</option>
                  <template x-for="f in vocab.fontPairings" :key="f"><option :value="f" x-text="f"></option></template>
                </select>
              </div>
              <div class="field" x-id="['field']">
                <label :for="$id('field')">Planned at</label>
                <input type="datetime-local" x-model="spec.plannedAt" :id="$id('field')">
              </div>
              <div class="field full" x-id="['field']">
                <label :for="$id('field')">Caption</label>
                <textarea class="autogrow" x-model="spec.caption" placeholder="The post caption…" :id="$id('field')"></textarea>
              </div>
              <div class="field full" x-id="['field']">
                <label :for="$id('field')">Hashtags</label>
                <input type="text" x-model="hashtagsText" placeholder="pushword, carousel" :id="$id('field')">
              </div>
            </div>

            <div class="grid2">
              <div class="field" x-id="['field']">
                <label :for="$id('field')">Palette · background</label>
                <button type="button" class="color-field" @click.stop="openColor(spec.palette, 'bg', $event)" :id="$id('field')">
                  <span class="sw" :style="spec.palette.bg ? ('background:' + spec.palette.bg) : ''"></span>
                  <span class="hex" :class="!spec.palette.bg && 'empty'" x-text="spec.palette.bg || 'inherit'"></span>
                  <span class="caret">▾</span>
                </button>
              </div>
              <div class="field" x-id="['field']">
                <label :for="$id('field')">Palette · text</label>
                <button type="button" class="color-field" @click.stop="openColor(spec.palette, 'text', $event)" :id="$id('field')">
                  <span class="sw" :style="spec.palette.text ? ('background:' + spec.palette.text) : ''"></span>
                  <span class="hex" :class="!spec.palette.text && 'empty'" x-text="spec.palette.text || 'inherit'"></span>
                  <span class="caret">▾</span>
                </button>
              </div>
              <div class="field" x-id="['field']">
                <label :for="$id('field')">Palette · accent</label>
                <button type="button" class="color-field" @click.stop="openColor(spec.palette, 'accent', $event)" :id="$id('field')">
                  <span class="sw" :style="spec.palette.accent ? ('background:' + spec.palette.accent) : ''"></span>
                  <span class="hex" :class="!spec.palette.accent && 'empty'" x-text="spec.palette.accent || 'inherit'"></span>
                  <span class="caret">▾</span>
                </button>
              </div>
              <div class="field" x-id="['field']">
                <label :for="$id('field')">Creator</label>
                <template x-if="'object' === typeof spec.creator && null !== spec.creator">
                  <input type="text" :value="'Inline: ' + spec.creator.name" disabled title="Inline creator set via API/JSON — edit it in the Source view" :id="$id('field')">
                </template>
                <template x-if="'object' !== typeof spec.creator || null === spec.creator">
                  <select x-model="spec.creator" x-init="$nextTick(() => $el.value = spec.creator || '')" :id="$id('field')">
                    <option value="">— brand —</option>
                    <template x-for="(name, key) in vocab.creators" :key="key"><option :value="key" x-text="name"></option></template>
                    <template x-if="spec.creator && !((spec.creator || '') in vocab.creators)">
                      <option :value="spec.creator" x-text="spec.creator + ' — unknown key'"></option>
                    </template>
                  </select>
                </template>
              </div>
              <div class="field" x-id="['field']">
                <label :for="$id('field')">Counter style</label>
                <select x-model="spec.counter.style" x-init="$nextTick(() => $el.value = spec.counter.style)" :id="$id('field')">
                  <option value="">— default —</option><template x-for="s in vocab.counterStyles" :key="s"><option :value="s" x-text="s"></option></template>
                </select>
              </div>
              <div class="field" x-id="['field']">
                <label :for="$id('field')">Counter align</label>
                <select x-model="spec.counter.align" x-init="$nextTick(() => $el.value = spec.counter.align)" :id="$id('field')">
                  <option value="">— default —</option><template x-for="a in vocab.counterAligns" :key="a"><option :value="a" x-text="a"></option></template>
                </select>
              </div>
              <div class="field" x-id="['field']">
                <label :for="$id('field')">Creator on slides</label>
                <select x-model="spec.creatorOnSlides" x-init="$nextTick(() => $el.value = spec.creatorOnSlides)" :id="$id('field')">
                  <option value="">— default —</option><template x-for="o in vocab.creatorOnSlides" :key="o"><option :value="o" x-text="o"></option></template>
                </select>
              </div>
              <div class="field" x-id="['field']">
                <label :for="$id('field')">Creator orientation</label>
                <select x-model="spec.creatorOrientation" x-init="$nextTick(() => $el.value = spec.creatorOrientation)" :id="$id('field')">
                  <option value="">— default —</option><template x-for="o in vocab.creatorOrientations" :key="o"><option :value="o" x-text="o"></option></template>
                </select>
              </div>
              <div class="field full" x-id="['field']">
                <div class="pw-help-label"><label :for="$id('field')">Background effect</label> {{ contextHelp.help('Background effect', 'repurposeHelpEffect'|trans) }}</div>
                <button type="button" class="fake-select" @click="openEffect('deck')" :id="$id('field')">
                  <span class="thumb" x-html="effectPreviewSvg(spec.background || 'none')"></span>
                  <span class="lbl" x-text="effectLabel(spec.background || 'none')"></span>
                  <span class="caret">▾</span>
                </button>
              </div>
            </div>
          </div>
        </section>

        <section class="group">
          <h2>Slides · <span x-text="spec.slides.length"></span></h2>
          <div class="slides-list">
            <template x-for="(slide, i) in spec.slides" :key="i">
              <div class="slide-item" :id="'rp-slide-item-' + i"
                   :class="{ 'open': slidesOpen[i], 'dragging': dragIndex === i, 'drag-over': dropIndex === i && dragIndex !== null && dragIndex !== i }"
                   @dragover.prevent="onDragOver(i)" @drop.prevent="onDrop(i)">
                <div class="slide-item__head">
                  <button type="button" class="grip" title="Drag to reorder, or use the arrow keys" draggable="true" :aria-label="'Reorder slide ' + (i + 1)"
                          @keydown.arrow-up.prevent="i > 0 && moveSlideTo(i, i - 1)" @keydown.arrow-down.prevent="i < spec.slides.length - 1 && moveSlideTo(i, i + 1)"
                          @dragstart="onDragStart(i, $event)" @dragend="onDragEnd()">⠿</button>
                  <button type="button" class="slide-item__toggle" @click="toggleSlide(i)" :aria-expanded="!!slidesOpen[i]" :aria-controls="'rp-slide-fields-' + i">
                    <span class="chev" aria-hidden="true" x-text="slidesOpen[i] ? '▾' : '▸'"></span>
                    <span class="slide-item__title" x-text="slide.title || slide.tagline || (slide.texts && slide.texts[0] && slide.texts[0].content) || 'Untitled'"></span>
                  </button>
                  <span class="sp" @click.stop>
                    <button class="icon-btn danger" type="button" title="Remove" :aria-label="'Remove slide ' + (i + 1)" @click="removeSlide(i)">✕</button>
                  </span>
                </div>
                <div class="slide-item__body" :id="'rp-slide-fields-' + i" x-show="slidesOpen[i]" x-cloak>
                  <div class="field" x-id="['field']">
                    <label :for="$id('field')">Title
                      <button type="button" class="btn-xs" x-show="slide.title" x-cloak title="Convert to a free text box — same look, draggable anywhere on the slide" @click="freeTextFromField(i, 'title')">→ free text</button>
                    </label>
                    <textarea class="autogrow one" x-model="slide.title" :id="$id('field')"></textarea>
                  </div>
                  <div class="grid2">
                    <div class="field" x-id="['field']"><label :for="$id('field')">Tagline
                      <button type="button" class="btn-xs" x-show="slide.tagline" x-cloak title="Convert to a free text box — same look, draggable anywhere on the slide" @click="freeTextFromField(i, 'tagline')">→ free text</button>
                    </label><textarea class="autogrow one" x-model="slide.tagline" :id="$id('field')"></textarea></div>
                    <div class="field" x-id="['field']"><label :for="$id('field')">Background effect</label>
                      <button type="button" class="fake-select" @click="openEffect(i)" :id="$id('field')">
                        <span class="thumb" x-html="slideEffectPreview(slide)"></span>
                        <span class="lbl" x-text="slideEffectLabel(slide)"></span>
                        <span class="caret">▾</span>
                      </button>
                    </div>
                  </div>
                  <div class="field" x-id="['field']"><label :for="$id('field')">Paragraph
                    <button type="button" class="btn-xs" x-show="slide.paragraph" x-cloak title="Convert to a free text box — same look, draggable anywhere on the slide" @click="freeTextFromField(i, 'paragraph')">→ free text</button>
                  </label><textarea class="autogrow" x-model="slide.paragraph" :id="$id('field')"></textarea></div>
                  <div class="grid2">
                    <div class="field" x-id="['field']"><label :for="$id('field')">Layout</label>
                      <select x-model="slide.layout" x-init="$nextTick(() => $el.value = slide.layout)" :id="$id('field')">
                        <template x-for="l in vocab.layouts" :key="l"><option :value="l" x-text="l"></option></template>
                      </select>
                    </div>
                    <div class="field" x-id="['field']"><label :for="$id('field')">Align</label>
                      <select x-model="slide.align" x-init="$nextTick(() => $el.value = slide.align)" :id="$id('field')">
                        <template x-for="a in vocab.aligns" :key="a"><option :value="a" x-text="a"></option></template>
                      </select>
                    </div>
                    <div class="field" x-id="['field']">
                      <label :for="$id('field')">Overlay <span class="val" x-text="Number(slide.overlay || 0).toFixed(2)"></span></label>
                      <input type="range" min="0" max="1" step="0.05" x-model.number="slide.overlay" :id="$id('field')">
                    </div>
                    <div class="field" x-id="['field']">
                      <label :for="$id('field')">Text scale <span class="val" x-text="Number(slide.textScale || 1).toFixed(2)"></span></label>
                      <input type="range" min="0.5" max="2" step="0.05" x-model.number="slide.textScale" :id="$id('field')">
                    </div>
                  </div>
                  <label class="switch"><input type="checkbox" x-model="slide.swipe"> Swipe hint (“→”)</label>

                  <div class="grid2">
                    <div class="field" x-id="['field']">
                      <div class="pw-help-label"><label :for="$id('field')">Palette · bg</label> {{ contextHelp.help('Palette', 'repurposeHelpPalette'|trans, true) }}</div>
                      <button type="button" class="color-field" @click.stop="openColor(slide.palette, 'bg', $event)" :id="$id('field')">
                        <span class="sw" :style="slide.palette.bg ? ('background:' + slide.palette.bg) : ''"></span>
                        <span class="hex" :class="!slide.palette.bg && 'empty'" x-text="slide.palette.bg || 'inherit'"></span>
                        <span class="caret">▾</span>
                      </button>
                    </div>
                    <div class="field" x-id="['field']">
                      <label :for="$id('field')">Palette · text</label>
                      <button type="button" class="color-field" @click.stop="openColor(slide.palette, 'text', $event)" :id="$id('field')">
                        <span class="sw" :style="slide.palette.text ? ('background:' + slide.palette.text) : ''"></span>
                        <span class="hex" :class="!slide.palette.text && 'empty'" x-text="slide.palette.text || 'inherit'"></span>
                        <span class="caret">▾</span>
                      </button>
                    </div>
                    <div class="field" x-id="['field']">
                      <label :for="$id('field')">Palette · accent</label>
                      <button type="button" class="color-field" @click.stop="openColor(slide.palette, 'accent', $event)" :id="$id('field')">
                        <span class="sw" :style="slide.palette.accent ? ('background:' + slide.palette.accent) : ''"></span>
                        <span class="hex" :class="!slide.palette.accent && 'empty'" x-text="slide.palette.accent || 'inherit'"></span>
                        <span class="caret">▾</span>
                      </button>
                    </div>
                    <div class="field" x-id="['field']">
                      <label :for="$id('field')">Title highlight</label>
                      <button type="button" class="color-field" @click.stop="openColor(slide, 'highlight', $event)" :id="$id('field')">
                        <span class="sw" :style="slide.highlight ? ('background:' + slide.highlight) : ''"></span>
                        <span class="hex" :class="!slide.highlight && 'empty'" x-text="slide.highlight || 'none'"></span>
                        <span class="caret">▾</span>
                      </button>
                    </div>
                  </div>

                  <div class="field" x-id="['field']">
                    <label :for="$id('field')">Image layout</label>
                    <select x-model="slide.imageLayout" @change="ensureCells(slide)" x-init="$nextTick(() => $el.value = slide.imageLayout)" :id="$id('field')">
                      <template x-for="l in vocab.imageLayouts" :key="l"><option :value="l" x-text="l"></option></template>
                    </select>
                  </div>

                  <template x-for="k in imageSlots(slide)" :key="k">
                    <div class="image-cell">
                      <div class="field" x-id="['field']">
                        <label :for="$id('field')">Image <span class="val" x-show="cellCount(slide) > 1" x-text="k === 0 ? 'A' : 'B'"></span></label>
                        <div class="media-picker" :class="!cellImage(slide, k).media && 'is-empty'">
                          <div class="media-picker__thumb" :style="cellImage(slide, k).media ? ('background-image:url(\'' + thumbUrl(cellImage(slide, k).media) + '\')') : ''"></div>
                          <div class="media-picker__meta">
                            <span class="media-picker__name" x-text="cellImage(slide, k).media || 'No image'"></span>
                            <div class="media-picker__actions">
                              <button type="button" class="btn-xs" @click="pickMedia(i, k, 'choose')" :id="$id('field')">Choose</button>
                              <button type="button" class="btn-xs" @click="pickMedia(i, k, 'upload')">Upload</button>
                              <button type="button" class="btn-xs danger" x-show="cellImage(slide, k).media" @click="clearMedia(i, k)">Remove</button>
                            </div>
                          </div>
                        </div>
                      </div>
                      <div class="grid2" x-show="cellImage(slide, k).media">
                        <div class="field" x-id="['field']">
                          <label :for="$id('field')">Focus X <span class="val" x-text="Number(cellImage(slide, k).focusX ?? 0.5).toFixed(2)"></span></label>
                          <input type="range" min="0" max="1" step="0.01" x-model.number="cellImage(slide, k).focusX" :id="$id('field')">
                        </div>
                        <div class="field" x-id="['field']">
                          <label :for="$id('field')">Focus Y <span class="val" x-text="Number(cellImage(slide, k).focusY ?? 0.5).toFixed(2)"></span></label>
                          <input type="range" min="0" max="1" step="0.01" x-model.number="cellImage(slide, k).focusY" :id="$id('field')">
                        </div>
                        <div class="field full" x-id="['field']">
                          <label :for="$id('field')">Zoom <span class="val" x-text="Number(cellImage(slide, k).zoom ?? 1).toFixed(2)"></span></label>
                          <input type="range" min="1" max="5" step="0.1" x-model.number="cellImage(slide, k).zoom" :id="$id('field')">
                        </div>
                      </div>
                    </div>
                  </template>

                  <template x-for="(t, k) in slide.texts" :key="k">
                    <div class="free-text">
                      <div class="field" x-id="['field']">
                        <label :for="$id('field')">Free text <span class="sp" @click.stop><button class="icon-btn danger" type="button" title="Remove" @click="removeText(slide, k)">✕</button></span></label>
                        <textarea class="autogrow one" x-model="t.content" :id="$id('field')"></textarea>
                      </div>
                      <div class="grid2">
                        <div class="field" x-id="['field']">
                          <label :for="$id('field')">X <span class="val" x-text="Number(t.x ?? 0.08).toFixed(2)"></span></label>
                          <input type="range" min="0" :max="(1 - (t.width ?? 0.84)).toFixed(2)" step="0.01" x-model.number="t.x" :id="$id('field')">
                        </div>
                        <div class="field" x-id="['field']">
                          <label :for="$id('field')">Y <span class="val" x-text="Number(t.y ?? 0.08).toFixed(2)"></span></label>
                          <input type="range" min="0" max="0.95" step="0.01" x-model.number="t.y" :id="$id('field')">
                        </div>
                        <div class="field" x-id="['field']">
                          <label :for="$id('field')">Width <span class="val" x-text="Number(t.width ?? 0.84).toFixed(2)"></span></label>
                          <input type="range" min="0.05" :max="(1 - (t.x ?? 0.08)).toFixed(2)" step="0.01" x-model.number="t.width" :id="$id('field')">
                        </div>
                        <div class="field" x-id="['field']">
                          <label :for="$id('field')">Size <span class="val" x-text="(Number(t.size ?? 0.05) * 100).toFixed(1) + '% of slide width'"></span></label>
                          <input type="range" min="0.01" max="0.3" step="0.005" x-model.number="t.size" :id="$id('field')">
                        </div>
                        <div class="field" x-id="['field']"><label :for="$id('field')">Align</label>
                          <select x-model="t.align" x-init="$nextTick(() => $el.value = t.align)" :id="$id('field')">
                            <template x-for="a in vocab.aligns" :key="a"><option :value="a" x-text="a"></option></template>
                          </select>
                        </div>
                        <div class="field" x-id="['field']"><label :for="$id('field')">Font</label>
                          <select x-model="t.font" x-init="$nextTick(() => $el.value = t.font)" :id="$id('field')">
                            <template x-for="f in vocab.textFonts" :key="f"><option :value="f" x-text="f"></option></template>
                          </select>
                        </div>
                        <div class="field" x-id="['field']">
                          <label :for="$id('field')">Colour</label>
                          <button type="button" class="color-field" @click.stop="openColor(t, 'color', $event)" :id="$id('field')">
                            <span class="sw" :style="t.color ? ('background:' + t.color) : ''"></span>
                            <span class="hex" :class="!t.color && 'empty'" x-text="t.color || 'inherit'"></span>
                            <span class="caret">▾</span>
                          </button>
                        </div>
                        <div class="field" x-id="['field']">
                          <label :for="$id('field')">Highlight</label>
                          <button type="button" class="color-field" @click.stop="openColor(t, 'highlight', $event)" :id="$id('field')">
                            <span class="sw" :style="t.highlight ? ('background:' + t.highlight) : ''"></span>
                            <span class="hex" :class="!t.highlight && 'empty'" x-text="t.highlight || 'none'"></span>
                            <span class="caret">▾</span>
                          </button>
                        </div>
                      </div>
                    </div>
                  </template>
                  <button class="btn-xs" type="button" @click="addText(slide)">+ Add free text</button>
                </div>
              </div>
            </template>
          </div>
          <button class="btn" type="button" @click="addSlide()">+ Add slide</button>
        </section>
      </div>

      {# ---------- SOURCE EDITOR ---------- #}
      <div id="rp-source-editor" role="region" aria-label="Source editor" x-show="view === 'source'" x-cloak style="display:flex;flex-direction:column;gap:.6rem;">
        <div>JSON {{ contextHelp.help('JSON', 'repurposeHelpSource'|trans) }}</div>
        <div class="source-wrap">
          <textarea id="rp-spec" x-ref="source" spellcheck="false" aria-label="Carousel spec JSON"></textarea>
        </div>
      </div>
    </aside>
  </div>

  <dialog class="rp-modal" x-effect="mediaModal.open ? $el.showModal() : $el.close()" @cancel="closeMediaModal()" @close="closeMediaModal()" aria-labelledby="rp-media-title">
    <div class="rp-modal__panel">
      <div class="rp-modal__bar">
        <span id="rp-media-title" x-text="_pickSlide === 'audio' ? messages.audioTitle : (_pickSlide === 'video' ? messages.videoTitle : 'Choose an image')"></span>
        <button class="icon-btn" type="button" @click="closeMediaModal()" aria-label="Close">✕</button>
      </div>
      <iframe class="rp-modal__frame" :src="mediaModal.src" title="Media picker"></iframe>
    </div>
  </dialog>

  {# ---------- INLINE TEXT EDITOR (opens on click on a slide's text block) ---------- #}
  {# Object-syntax :style on purpose: a string binding rewrites the whole style
     attribute, wiping the display x-show manages — and x-show skips re-applying
     when its value did not change, so the wipe would stick (ghost popover). #}
  <div class="text-pop" x-show="textPop.open" x-cloak :style="{ top: textPop.top + 'px', left: textPop.left + 'px' }"
       @click.outside="closeTextPop()" @keydown.escape.window="closeTextPop()">
    <label for="rp-inline-text" x-text="textPopLabel"></label>
    <textarea id="rp-inline-text" class="autogrow" x-ref="textPopField" x-model="editValue"></textarea>
  </div>

  {# ---------- COLOUR POPOVER (shared, anchored under the clicked field) ---------- #}
  {# Object syntax for the same reason as .text-pop above. #}
  <div class="color-pop" x-show="colorPop.open" x-cloak :style="{ top: colorPop.top + 'px', left: colorPop.left + 'px' }"
       @click.outside="closeColor()" @keydown.escape.window="closeColor()">
    <div class="color-pop__top">
      <span class="sw" :style="colorValue ? ('background:' + colorValue) : ''"></span>
      <input type="text" aria-label="Colour value" x-model="colorValue" spellcheck="false" placeholder="#rrggbb / inherit">
      <input class="color-pop__native" type="color" title="Custom colour" aria-label="Custom colour"
             :value="/^#[0-9a-fA-F]{6}$/.test(colorValue) ? colorValue : '#000000'"
             @input="colorValue = $event.target.value">
    </div>
    <p class="color-contrast" x-show="colorContrast" x-cloak
       :class="colorContrast && (colorContrast.pass ? 'ok' : (colorContrast.passLarge ? 'warn' : 'bad'))">
      <span x-text="colorContrast ? ('Contrast ' + colorContrast.ratio + ':1') : ''"></span>
      <span x-text="colorContrast ? (colorContrast.pass ? 'AA ✓' : (colorContrast.passLarge ? 'AA large only' : 'fails AA')) : ''"></span>
    </p>
    <div class="color-suggest" x-show="suggestedColors.length" x-cloak>
      <template x-for="c in suggestedColors" :key="c.name">
        <button type="button" class="tw-sw" :style="'background:' + c.hex" :title="c.name + ' ' + c.hex" :aria-label="c.name + ' ' + c.hex" @click="pickSwatch(c.hex)"></button>
      </template>
      <span class="color-suggest__label">deck / site</span>
    </div>
    <div class="tw-grid">
      <template x-for="c in tailwind" :key="c.name">
        <button type="button" class="tw-sw" :style="'background:' + c.hex" :title="c.name + ' ' + c.hex" :aria-label="c.name + ' ' + c.hex" @click="pickSwatch(c.hex)"></button>
      </template>
    </div>
    <button type="button" class="color-pop__clear" @click="clearColor()">Clear — inherit site colour</button>
  </div>

  {# ---------- BACKGROUND-EFFECT PICKER MODAL ---------- #}
  <dialog class="rp-modal effect-modal" x-effect="effectModal.open ? $el.showModal() : $el.close()" @cancel="closeEffect()" @close="closeEffect()" aria-labelledby="rp-effect-title">
    <div class="rp-modal__panel">
      <div class="rp-modal__bar">
        <span id="rp-effect-title">Select a background effect</span>
        <button class="icon-btn" type="button" @click="closeEffect()" aria-label="Close">✕</button>
      </div>
      <div class="effect-tabs">
        <template x-for="t in effectTabs" :key="t">
          <button type="button" :class="effectModal.tab === t && 'on'" @click="effectModal.tab = t" x-text="t"></button>
        </template>
      </div>
      <div class="effect-grid">
        <template x-for="e in effectsInTab" :key="e.key">
          <button type="button" class="effect-tile" :class="currentEffectKey === e.key && 'on'" :aria-pressed="currentEffectKey === e.key" @click="chooseEffect(e.key)">
            <span class="thumb" x-html="e.preview"></span>
            <span class="name" x-text="e.label"></span>
          </button>
        </template>
      </div>
    </div>
  </dialog>

  <script defer src="{{ versionedAsset('/bundles/pushwordrepurpose/repurpose.js') }}"></script>
  <script defer src="{{ versionedAsset('/bundles/pushwordcore/alpine.js') }}"></script>
</body>
</html>
