{% extends '@EasyAdmin/page/content.html.twig' %}

{% block head_stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ versionedAsset('/bundles/pushwordadmin/admin.css') }}">
{% endblock %}

{% block body_javascript %}
    {{ parent() }}
    <script src="{{ versionedAsset('/bundles/pushwordadmin/admin.js') }}"></script>
{% endblock %}

{% block content_title %}{{ 'template_editorTitle'|trans }}{% endblock %}

{% block page_actions %}
    {% if canCreate %}
        <a class="btn btn-primary" href="{{ path('admin_template_editor_create') }}">
            <i class="fa fa-plus-circle me-2" aria-hidden="true"></i> {{ 'template_editorAdd'|trans }}
        </a>
    {% endif %}
{% endblock %}

{% block main %}
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 pw-template-list">
            <thead class="table-light">
                <tr>
                    <th scope="col">{{ 'template_editorPath'|trans }}</th>
                    <th scope="col" class="text-end">{{ 'template_editorAction'|trans }}</th>
                </tr>
            </thead>
            <tbody>
            {% for element in elements %}
                <tr>
                    <td class="pw-template-list__path">
                        <a href="{{ path('admin_template_editor_edit', {encodedPath: element.encodedPath}) }}" class="pw-list-title">
                            {{ element.path }}
                        </a>
                    </td>
                    <td class="text-end pw-template-list__actions">
                        <div class="d-flex flex-wrap justify-content-end align-items-center gap-2">
                            <a href="{{ path('admin_template_editor_edit', {encodedPath: element.encodedPath}) }}" class="btn btn-secondary btn-sm">
                                <i class="fa fa-edit me-1" aria-hidden="true"></i> {{ 'template_editorEdit'|trans }}
                            </a>
                            {% if canCreate %}
                                <a href="{{ path('admin_template_editor_delete', {encodedPath: element.encodedPath}) }}" class="btn btn-link btn-sm pw-action-delete">
                                    <i class="fa fa-times me-1" aria-hidden="true"></i> {{ 'template_editorDeleteLabel'|trans }}
                                </a>
                            {% endif %}
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="2" class="text-center text-muted py-4">
                        {{ 'template_editorEmpty'|trans }}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
