{
  "name": "pushword/template-editor",
  "type": "symfony-bundle",
  "description": "Edit Twig view files online from the Pushword admin.",
  "keywords": ["twig", "template-editor", "theme-editor", "admin", "cms", "pushword"],
  "homepage": "https://pushword.piedweb.com",
  "license": "MIT",
  "support": {
    "issues": "https://github.com/Pushword/Pushword/issues",
    "source": "https://github.com/Pushword/Pushword/tree/main/packages/template-editor",
    "docs": "https://pushword.piedweb.com"
  },
  "require": {
    "pushword/core": "*"
  },
  "extra": {
    "branch-alias": {
      "dev-main": "1.0.x-dev"
    }
  },
  "autoload": {
    "psr-4": {
      "Pushword\\TemplateEditor\\": "src"
    }
  },
  "authors": [
    {
      "name": "Robin@PiedWeb",
      "email": "contact@piedweb.com",
      "homepage": "https://piedweb.com"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true
}
