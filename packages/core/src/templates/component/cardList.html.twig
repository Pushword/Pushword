
{% set cardTemplate = cardTemplate|default(view('/component/card.html.twig')) %}
{% set itemClass = itemClass|default('') %}

{# The columns live on the wrapper alone (grid), so a wrapperClass — or the block
   editor's class tune — can change the layout without overriding item classes.
   Items stay class-less unless a caller needs a width there (the scroller does). #}
<ul
  {% if id is defined and id is not null %}id="{{ id }}"{% endif %}
  class="{{ wrapperClass|default('not-prose grid gap-2 sm:grid-cols-2 md:grid-cols-3 my-5') }}">
  {%- for item in items -%}
    <li{% if item.id is defined and item.id %} id="{{ item.id }}"{% endif %}{% if itemClass %} class="{{ itemClass }}"{% endif %}>
      {{- include(cardTemplate, isInstanceOfPage(item)
      ? {page: item}
      : {
        page: item.page ?? null,
        image: item.image ?? null,
        imageAlt: item.imageAlt ?? null,
        title: item.title,
        link: item.link ?? null,
        obfuscateLink: item.obfuscateLink ?? false,
        date: item.date ?? null,
        title_tag: item.title_tag ?? null,
        buttonLink: item.buttonLink ?? null,
        buttonLinkLabel: item.buttonLinkLabel ?? null,
        description: item.description ?? null,
      }) -}}
    </li>
  {%- endfor -%}
</ul>
