{% extends view('/base.html.twig') %}

{% block title %}User{% endblock %}

{% block css %}
  {{ parent() }}
  {# The default --primary is too light behind white text; a site's own primary is its call. #}
  <style>
    .pw-user-auth { --pw-auth-action: {{ apps.get().get('css_var:color_primary') is null ? 'oklch(50% 0.134 242.749)' : 'var(--primary)' }}; }
    .pw-auth-action { min-height: 2.75rem; background-color: var(--pw-auth-action); }
    .pw-auth-action:hover { background-color: color-mix(in oklch, var(--pw-auth-action), black 12%); }
    .pw-auth-action:focus { --tw-ring-color: var(--pw-auth-action); }
    .pw-user-auth a.text-primary { color: var(--pw-auth-action); }
    .pw-user-auth a.text-primary:hover { color: color-mix(in oklch, var(--pw-auth-action), black 12%); }
  </style>
{% endblock %}

{% block body %}

<div class="pw-user-auth flex items-center justify-center min-h-screen px-4 py-12 bg-gray-50 sm:px-6 lg:px-8" hx-boost="false">
    <div class="w-full max-w-md space-y-8">
        <div>
            <h1 class="mt-6 text-3xl font-bold text-center text-gray-900">
                {{ block('title') }}
            </h1>
        </div>
        {% block main_content %}{% endblock %}
    </div>
</div>

{% endblock %}
