{% extends view('/user/layout.html.twig') %}

{% block title %}{{ 'setPasswordTitle'|trans }}{% endblock %}

{% block main_content %}
<form method="post" class="mt-8 space-y-6">
    {% if error %}
        <div role="alert" id="password-error" class="flex items-center gap-3 p-5 text-red-800 bg-red-50 rounded">
            <svg class="w-5 h-5 shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd"/></svg>
            <span>{{ error|trans }}</span>
        </div>
    {% endif %}

    <div class="-space-y-px rounded-md shadow-xs">
        <div class="relative">
            <label for="password" class="sr-only">{{ 'newPassword'|trans }}</label>
            <input type="password" id="password" name="password" required
                   minlength="7" autofocus autocomplete="new-password"
                   class="relative block w-full px-3 py-2 pr-11 text-gray-900 placeholder-gray-500 border border-gray-300 rounded-none appearance-none rounded-t-md focus:outline-hidden focus:ring-primary focus:border-primary focus:z-10 sm:text-sm"
                   placeholder="{{ 'newPassword'|trans }}"
                   {% if error %}aria-describedby="password-error" aria-invalid="true"{% endif %} />
            <button type="button"
                    class="absolute inset-y-0 right-0 z-20 flex items-center px-3 text-gray-500 hover:text-gray-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-inset"
                    aria-label="{{ 'securityLoginTogglePassword'|trans }}"
                    aria-controls="password"
                    aria-pressed="false"
                    data-password-toggle>
                <svg class="w-5 h-5" data-password-hidden-icon fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                <svg class="w-5 h-5" data-password-visible-icon hidden fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.542-7a9.97 9.97 0 012.31-3.775M6.938 6.938A9.966 9.966 0 0112 5c4.478 0 8.268 2.943 9.542 7a9.97 9.97 0 01-4.043 5.063M6.938 6.938L3 3m3.938 3.938l3.124 3.124M21 21l-3.938-3.938m0 0l-3.124-3.124m6.187-1.938a3 3 0 01-4.243 4.243"/></svg>
            </button>
        </div>
        <div class="relative">
            <label for="password_confirm" class="sr-only">{{ 'confirmPassword'|trans }}</label>
            <input type="password" id="password_confirm" name="password_confirm" required
                   minlength="7" autocomplete="new-password"
                   class="relative block w-full px-3 py-2 pr-11 text-gray-900 placeholder-gray-500 border border-gray-300 rounded-none appearance-none rounded-b-md focus:outline-hidden focus:ring-primary focus:border-primary focus:z-10 sm:text-sm"
                   placeholder="{{ 'confirmPassword'|trans }}" />
            <button type="button"
                    class="absolute inset-y-0 right-0 z-20 flex items-center px-3 text-gray-500 hover:text-gray-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-inset"
                    aria-label="{{ 'securityLoginTogglePassword'|trans }}"
                    aria-controls="password_confirm"
                    aria-pressed="false"
                    data-password-toggle>
                <svg class="w-5 h-5" data-password-hidden-icon fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                <svg class="w-5 h-5" data-password-visible-icon hidden fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.542-7a9.97 9.97 0 012.31-3.775M6.938 6.938A9.966 9.966 0 0112 5c4.478 0 8.268 2.943 9.542 7a9.97 9.97 0 01-4.043 5.063M6.938 6.938L3 3m3.938 3.938l3.124 3.124M21 21l-3.938-3.938m0 0l-3.124-3.124m6.187-1.938a3 3 0 01-4.243 4.243"/></svg>
            </button>
        </div>
    </div>

    <button type="submit" class="relative flex justify-center w-full px-4 py-2 text-sm font-medium text-white border border-transparent rounded-md bg-primary group hover:opacity-75 focus:outline-hidden focus:ring-2 focus:ring-offset-2 focus:ring-primary">
        <span class="absolute inset-y-0 left-0 flex items-center pl-3">
            <svg class="w-5 h-5 text-primary group-hover:text-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
            </svg>
        </span>
        {{ 'setPasswordButton'|trans }}
    </button>
</form>
{% endblock %}
