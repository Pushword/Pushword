(performance_{{ domain_snake }}) {
	encode zstd br gzip

	file_server {
		precompressed zstd br gzip
	}
}

(cache_{{ domain_snake }}) {
	# Assets: 1 year
	@assets path *.ico *.pdf *.flv *.jpg *.jpeg *.png *.gif *.webp *.svg *.eot *.ttf *.woff *.woff2 *.js *.css
	header @assets Cache-Control "max-age=31536000, public"

	# Default: {{ html_max_age }}s{% if html_swr > 0 %} + stale-while-revalidate={{ html_swr }}s{% endif %}
	header Cache-Control "max-age={{ html_max_age }}, public{% if html_swr > 0 %}, stale-while-revalidate={{ html_swr }}{% endif %}"
}

(security_{{ domain_snake }}) {
	header {
		Content-Security-Policy "base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' {{ live_origin }}"
		Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	@dotfiles path_regexp /\..*
	respond @dotfiles 403
}



{% block route %}http://{{ domain }} {
	redir https://{host}{uri} permanent
}

{{ domain }}{% endblock %} {
    {% block before_rules %}{% endblock %}

	root * {{ staticDir }}

	import performance_{{ domain_snake }}
	import cache_{{ domain_snake }}
	import security_{{ domain_snake }}

    file_server

	# Redirects
	redir /index.{html,php,aspx,cfm} / 301


	{% if redirections is not empty %}
	# Page Redirections
    {{ redirections|raw }}
	{% endif %}


	# Old media redirect
	@old_media path_regexp ^/media/(small_thumb|height_300|xs|sm|md|lg|xl|default)/media(.*)$
	redir @old_media /media/{re.1}{re.2} 301

	# HTML extension handling
	@has_slash path_regexp ^/(.+)/$
	redir @has_slash /{re.1} 301

	@no_ext {
		path_regexp ^/([a-zA-Z0-9\-_/\.]+)$
		file {
			try_files {path}.html
		}
	}
	rewrite @no_ext {path}.html

	# Permit to redirect slug.html to slug
	@html_ext path_regexp ^(.+)\.html$
	redir @html_ext {re.1} 301

{% if image_fallback_order is defined and image_fallback_order.webp_fallback|length > 0 %}
	# Image Format Fallback (webp to available format)
	# WebP fallback: if .webp doesn't exist, try {{ image_fallback_order.webp_fallback|join(', ') }}.
	# Caddy evaluates the matchers of one named set in non-deterministic order (a Go map
	# walk, caddyserver/caddy#6904), so no matcher may read {re.webp.1} from its
	# path_regexp sibling — the capture-dependent probing lives in the try_files
	# directive instead, which runs after the whole set has matched, when the capture is
	# reliably set. A genuine miss falls through to {path}, keeping the URI intact for
	# downstream handling (a reverse_proxy fallback, handle_errors).
	@webp_fallback {
		path_regexp webp ^/media/(.+)\.webp$
		not file {path}
	}
	route @webp_fallback {
		try_files /media/{re.webp.1}.jpg /media/{re.webp.1}.jpeg /media/{re.webp.1}.png /media/{re.webp.1}.gif {path}
	}
{% endif %}

	# Error pages (localized 404.html for URLs under /{locale}/)
	handle_errors {
		header Cache-Control "no-store, no-cache, must-revalidate"
{% for locale in extra_locales %}
		@error_{{ locale }} path /{{ locale }} /{{ locale }}/*
		handle @error_{{ locale }} {
			rewrite * /{{ locale }}/404.html
		}
{% endfor %}
		handle {
			rewrite * /404.html
		}
		file_server
	}

    {% block after_rules %}{% endblock %}

}

{% block redirect_www %}
# Redirect www subfolder to domain.tld
# The htaccess version has more scenarios
www.{{ domain }} {
    redir https://{{ domain }}{uri} 301
}
{% endblock %}
