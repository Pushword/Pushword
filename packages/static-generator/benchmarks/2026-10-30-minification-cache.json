  "optimization": "Cache minified HTML by freshly rendered input, backend identity, PHP/libxml/DomCrawler versions and minifier cache version.",
  "method": {
    "environment": "Private local snapshots and private SQLite databases.",
    "runtime": {
      "php": "8.5.12",
      "libxml": "2.12.10"
    },
    "rendering": "Full rebuilds, PHP rendering and minification, four workers pinned to homogeneous primary CPUs 0-3. Parent CLI opcache enabled, child CLI opcache unchanged.",
    "snapshots": "Installed site versions are retained; relevant static-generator and corpus-index improvements were backported identically into each private control and candidate. This compares the optimization on the captured site workloads, not an upgrade of every dependency.",
    "baseline": "Already includes unchanged compressed-export reuse. HTML rendering still runs in both modes.",
    "compression": "Existing gzip/Brotli/Zstandard settings unchanged. Each timed build starts from the same previous export, copied outside timing.",
    "cache": "Persistent minification pools were populated during preliminary builds outside the final sequence. Three warm candidate builds alternate with three uncached controls per site. Altimood/Pied Vert retain exploratory cold-cache samples for reference; these used an earlier affinity and do not enter the final medians.",
    "command": "php -d opcache.enable_cli=1 bin/console pw:static --workers=4 --format=text (GrandAngle: www.grandangle.fr; other sites: all hosts).",
    "timing": "Wall-clock medians. Shared workstation; raw samples include scheduling/load outliers. CPU user/system times from /usr/bin/time retained.",
    "parity": "Every export entry counted and compared by SHA-256 or exact symlink target, including compressed sidecars. No output paths ignored or normalized."
  },
