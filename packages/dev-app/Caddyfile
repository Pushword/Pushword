# The placeholders below are what lets this one file serve both a local
# `frankenphp run --config Caddyfile` and the container (see /docker); unset, every
# one of them falls back to the local default, so nothing changes for a native run.
{
	# The container turns the admin API on so its healthcheck can read /metrics.
	admin {$CADDY_ADMIN:off}
	frankenphp
}

(performance) {
	encode zstd br gzip

	file_server {
		precompressed zstd br gzip
	}
}

(cache) {
	# Images & fonts: 1 year
	@static path *.ico *.jpg *.jpeg *.png *.gif *.webp *.svg *.woff *.woff2 *.ttf *.eot
	header @static Cache-Control "max-age=31536000, public"

	# JS & CSS: 1 week
	@scripts path *.js *.css
	header @scripts Cache-Control "max-age=604800, public"
}

(security) {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# Defaults to `:0` — the first available port, like `symfony server:start`. The
# container sets CADDY_SERVER_NAME to `:80` (or to your domain, which also gets Caddy
# to provision the TLS certificate).
{$CADDY_SERVER_NAME::0} {
	root * public/

	php_server {
		resolve_root_symlink
		# Worker mode (a long-running kernel) is opt-in: set FRANKENPHP_WORKER_CONFIG
		# to `worker ./public/index.php 1` once `runtime/frankenphp-symfony` is
		# installed. Safe — see docs/content/performance.md. The gain mostly amortizes
		# the kernel boot, so it helps light pages most.
		{$FRANKENPHP_WORKER_CONFIG}
	}

	import performance
	import cache
	import security
}

# -- If you use static import Caddyfile generated --
# import static/example.tld/.Caddyfile
