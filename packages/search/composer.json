{
  "name": "pushword/search",
  "type": "symfony-bundle",
  "description": "Optional SQLite-native full-text search for Pushword CMS, powered by Loupe (zero infra).",
  "keywords": ["search", "full-text-search", "loupe", "sqlite", "cms", "symfony", "pushword"],
  "homepage": "https://pushword.piedweb.com/extension/search",
  "license": "MIT",
  "support": {
    "issues": "https://github.com/Pushword/Pushword/issues",
    "source": "https://github.com/Pushword/Pushword/tree/main/packages/search",
    "docs": "https://pushword.piedweb.com/extension/search"
  },
  "require": {
    "pushword/core": "*",
    "loupe/loupe": "^1.0"
  },
  "extra": {
    "branch-alias": {
      "dev-main": "1.0.x-dev"
    }
  },
  "autoload": {
    "psr-4": {
      "Pushword\\Search\\": "src"
    }
  },
  "authors": [
    {
      "name": "Robin@PiedWeb",
      "email": "contact@piedweb.com",
      "homepage": "https://piedweb.com"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true
}
