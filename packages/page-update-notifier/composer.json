{
  "name": "pushword/page-update-notifier",
  "type": "symfony-bundle",
  "description": "Get an email when a Pushword page is created or edited, throttled to a configurable interval.",
  "keywords": ["notification", "email", "content-change", "cms", "pushword"],
  "homepage": "https://pushword.piedweb.com",
  "license": "MIT",
  "support": {
    "issues": "https://github.com/Pushword/Pushword/issues",
    "source": "https://github.com/Pushword/Pushword/tree/main/packages/page-update-notifier",
    "docs": "https://pushword.piedweb.com"
  },
  "require": {
    "pushword/core": "*"
  },
  "extra": {
    "branch-alias": {
      "dev-main": "1.0.x-dev"
    }
  },
  "autoload": {
    "psr-4": {
      "Pushword\\PageUpdateNotifier\\": "src"
    }
  },
  "authors": [
    {
      "name": "Robin@PiedWeb",
      "email": "contact@piedweb.com",
      "homepage": "https://piedweb.com"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true
}
