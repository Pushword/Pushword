{# Double opt-in. One link, one unambiguous ask — unless the audience tracks
   clicks: then the consent is asked here too, as a second way to say yes. The
   confirm-and-accept button leads, the plain confirm stays one line below,
   equally able to open the subscription. #}
<!DOCTYPE html>
<html lang="{{ contact.locale }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ subject }}</title>
</head>
<body style="margin:0;padding:0;">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:100%;max-width:600px;">
    <tr>
        <td style="padding:24px 16px;font-family:Helvetica,Arial,sans-serif;font-size:16px;line-height:1.55;color:#1c1c1c;">
            <p style="margin:0 0 24px;">{{ 'newsletter.confirm.body'|trans({'%audience%': audience.name}, null, contact.locale) }}</p>
            {% if confirmTrackingUrl %}
              <p style="margin:0 0 12px;font-size:14px;color:#555555;">
                  {{ 'newsletter.confirm.trackingHint'|trans({}, null, contact.locale) }}
              </p>
              {# The plain link carries its tap padding (the two answers differ in
                 consent, so a fat finger aiming at the button must not land on it):
                 visible gaps come out at 16px inside the pair, 34px after it. #}
              <p style="margin:0 0 6px;">
                  <a href="{{ confirmTrackingUrl }}"
                     style="display:inline-block;padding:12px 24px;background-color:{{ primaryColor }};color:#ffffff;text-decoration:none;border-radius:4px;font-weight:bold;">
                      {{ 'newsletter.confirm.buttonTracking'|trans({}, null, contact.locale) }}
                  </a>
              </p>
              <p style="margin:0 0 24px;font-size:14px;">
                  <a href="{{ confirmUrl }}" style="display:inline-block;padding:10px 0;color:#555555;text-decoration:underline;">
                      {{ 'newsletter.confirm.buttonPlain'|trans({}, null, contact.locale) }}
                  </a>
              </p>
            {% else %}
              <p style="margin:0 0 24px;">
                  <a href="{{ confirmUrl }}"
                     style="display:inline-block;padding:12px 24px;background-color:{{ primaryColor }};color:#ffffff;text-decoration:none;border-radius:4px;font-weight:bold;">
                      {{ 'newsletter.confirm.button'|trans({}, null, contact.locale) }}
                  </a>
              </p>
            {% endif %}
            <p style="margin:0;font-size:12px;color:#6b6b6b;">
                {{ 'newsletter.confirm.ignore'|trans({}, null, contact.locale) }}
            </p>
        </td>
    </tr>
</table>
</body>
</html>
