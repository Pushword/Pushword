{# Double opt-in. It carries one link and nothing else, so the ask is unambiguous. #}
<!DOCTYPE html>
<html lang="{{ contact.locale }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ subject }}</title>
</head>
<body style="margin:0;padding:0;">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:100%;max-width:600px;">
    <tr>
        <td style="padding:24px 16px;font-family:Helvetica,Arial,sans-serif;font-size:16px;line-height:1.55;color:#1c1c1c;">
            <p style="margin:0 0 20px;">{{ 'newsletter.confirm.body'|trans({'%audience%': audience.name}, null, contact.locale) }}</p>
            <p style="margin:0 0 24px;">
                <a href="{{ confirmUrl }}"
                   style="display:inline-block;padding:12px 22px;background:{{ primaryColor }};color:#ffffff;text-decoration:none;border-radius:4px;">
                    {{ 'newsletter.confirm.button'|trans({}, null, contact.locale) }}
                </a>
            </p>
            <p style="margin:0;font-size:12px;color:#777777;">
                {{ 'newsletter.confirm.ignore'|trans({}, null, contact.locale) }}
            </p>
        </td>
    </tr>
</table>
</body>
</html>
