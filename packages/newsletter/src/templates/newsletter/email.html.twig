{#
  One-column newsletter body. Styles are inline and the layout is a table on
  purpose: mail clients strip <style> blocks and ignore modern layout.
#}
{% set emailHeader %}{% block email_header %}{{ header|raw }}{% endblock %}{% endset %}
{% set emailFooter %}{% block email_footer %}{{ footer|raw }}{% endblock %}{% endset %}
<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ subject }}</title>
</head>
<body style="margin:0;padding:0;{{ wrapped ? 'background-color:#f3f4f6;' }}">
{% if preheader %}
    <div style="display:none;max-height:0;overflow:hidden;opacity:0;">{{ preheader }}</div>
{% endif %}
{% if wrapped %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;background-color:#f3f4f6;">
    <tr><td align="center" style="padding:32px 12px;">
{% endif %}
<table role="presentation" width="600" cellpadding="0" cellspacing="0"{% if wrapped %} align="center"{% endif %} style="width:100%;max-width:600px;{{ wrapped ? 'background-color:#fafbfc;border-radius:12px;' }}">
    {% if emailHeader|trim is not empty %}
        <tr>
            <td style="padding:24px 16px 0;font-family:Helvetica,Arial,sans-serif;font-size:18px;line-height:1.5;color:#1c1c1c;">
                {{ emailHeader|raw }}
            </td>
        </tr>
    {% endif %}
    <tr>
        <td style="padding:24px 16px;font-family:Helvetica,Arial,sans-serif;font-size:16px;line-height:1.55;color:#1c1c1c;">
            {{ body|raw }}
        </td>
    </tr>
    {# Transactional mails retain public sender information without an unsubscribe link. #}
    {% if unsubscribeUrl or postalAddress or emailFooter|trim is not empty %}
        <tr>
            <td style="padding:0 16px 24px;font-family:Helvetica,Arial,sans-serif;font-size:12px;line-height:1.5;color:#6b6b6b;">
                <hr style="border:0;border-top:1px solid #e6e6e6;margin:0 0 16px;">
                {% if unsubscribeUrl %}
                    <a href="{{ unsubscribeUrl }}" style="color:#6b6b6b;">{{ 'newsletter.email.unsubscribe'|trans({}, null, locale) }} ({{ audienceName }})</a>
                {% endif %}
                {# The sender's real-world address, where the law asks for one. Kept
                   as authored — a postal address is laid out line by line. #}
                {% if postalAddress %}
                    <p style="margin:12px 0 0;white-space:pre-line;">{{ postalAddress }}</p>
                {% endif %}
                {% if emailFooter|trim is not empty %}
                    {{ emailFooter|raw }}
                {% endif %}
            </td>
        </tr>
    {% endif %}
</table>
{% if wrapped %}
    </td></tr>
</table>
{% endif %}
</body>
</html>
