{% extends '@PushwordNewsletter/newsletter/layout.html.twig' %}

{% block title %}{{ 'newsletter.unsubscribe.title'|trans }}{% endblock %}

{% block content %}
    <h1>{{ 'newsletter.unsubscribe.title'|trans }}</h1>
    <p>{{ 'newsletter.unsubscribe.body'|trans({'%audience%': audience.name}) }}</p>
    <p class="muted">{{ contact.email }}</p>
    {# The opt-out is a POST: a mail scanner following the link must not act on someone's behalf. #}
    <form method="post">
        <button type="submit">{{ 'newsletter.unsubscribe.confirm'|trans }}</button>
    </form>
{% endblock %}
