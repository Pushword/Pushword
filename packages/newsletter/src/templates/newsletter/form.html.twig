{#
  Subscription form. Rendered by `{{ newsletter_form('audience-slug') }}`, or by
  `{{ newsletter_form(['a-slug', 'another']) }}` to subscribe to several lists at
  once.

  The action is absolute and points at the audience's live host: on a statically
  generated site the page has no PHP behind it, so the post must cross origins.

  `.live-form` is js-helper's convention: liveBlock() binds the submit, posts it
  and swaps this block for the response. It re-binds on every DOMChanged, so the
  form still works when it is itself loaded into the page dynamically — an inline
  <script> would not, since one injected through innerHTML never runs. Without
  js-helper the browser posts and navigates, which still subscribes.
#}
{% set audience = audiences|first %}
<div class="live-form">
<form class="newsletter-form" method="post" action="{{ action }}">
    <input type="hidden" name="locale" value="{{ locale }}">
    {% if source %}<input type="hidden" name="source" value="{{ source }}">{% endif %}
    {% for interest in interests %}
        <input type="hidden" name="interests[]" value="{{ interest }}">
    {% endfor %}

    {% if audiences|length == 1 %}
        <input type="hidden" name="audience" value="{{ audience.slug }}">
    {% else %}
        {% for offered in audiences %}
            <input type="hidden" name="audiences[]" value="{{ offered.slug }}">
        {% endfor %}
    {% endif %}

    <label class="newsletter-form__label" for="newsletter-name-{{ audience.slug }}">{{ 'newsletter.form.name'|trans }}</label>
    <input class="newsletter-form__input" type="text" id="newsletter-name-{{ audience.slug }}"
           name="name" autocomplete="given-name">

    <label class="newsletter-form__label" for="newsletter-email-{{ audience.slug }}">{{ 'newsletter.form.email'|trans }}</label>
    <input class="newsletter-form__input" type="email" id="newsletter-email-{{ audience.slug }}"
           name="email" autocomplete="email" required>

    <div aria-hidden="true" style="position:absolute;left:-9999px;top:-9999px;">
        <label>{{ 'newsletter.form.honeypot'|trans }}<input type="text" name="website" tabindex="-1" autocomplete="off"></label>
    </div>

    <button class="newsletter-form__submit" type="submit">{{ 'newsletter.form.submit'|trans }}</button>
</form>
</div>
