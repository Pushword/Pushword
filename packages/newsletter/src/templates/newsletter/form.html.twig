{#
  Subscription form, served by the newsletter form endpoint and dropped into the
  page by the placeholder `newsletter_form()` left behind.

  The action is absolute and points at the audience's live host: on a statically
  generated site the page has no PHP behind it, so the post must cross origins.

  `.live-form` is js-helper's convention: liveBlock() binds the submit, posts it
  and swaps this block for the response. It re-binds on every DOMChanged, which
  is what picks this form up once the placeholder has been replaced by it.
  Without js-helper the browser posts and navigates, which still subscribes.

  Each set of utilities is a `pwNewsletter*Class` default: redefine it as a twig
  global to restyle that element without forking this template. Anything Twig
  would HTML-escape (`&`, `>`) cannot go in one — it would reach the class
  attribute mangled. See /extension/newsletter.
#}
{% set audience = audiences|first %}
<div class="live-form">
<form class="{{ pwNewsletterFormClass|default('w-full mt-4') }}" method="post" action="{{ action }}">
    <input type="hidden" name="locale" value="{{ locale }}">
    {% if csrfToken %}<input type="hidden" name="_token" value="{{ csrfToken }}">{% endif %}
    {% if source %}<input type="hidden" name="source" value="{{ source }}">{% endif %}
    {% for interest in interests %}
        <input type="hidden" name="interests[]" value="{{ interest }}">
    {% endfor %}

    {% if audiences|length == 1 %}
        <input type="hidden" name="audience" value="{{ audience.slug }}">
    {% else %}
        {% for offered in audiences %}
            <input type="hidden" name="audiences[]" value="{{ offered.slug }}">
        {% endfor %}
    {% endif %}

    <label class="{{ pwNewsletterLabelClass|default('block mb-1.5 text-sm font-medium text-gray-700') }}" for="newsletter-name-{{ audience.slug }}">{{ 'newsletter.form.name'|trans }}</label>
    <input class="{{ pwNewsletterInputClass|default('bg-white border-2 border-gray-100 w-full mb-3 py-2 px-4 text-gray-900 focus:outline-hidden focus:border-primary focus:ring-primary') }}" type="text" id="newsletter-name-{{ audience.slug }}"
           name="name" autocomplete="given-name">

    <label class="{{ pwNewsletterLabelClass|default('block mb-1.5 text-sm font-medium text-gray-700') }}" for="newsletter-email-{{ audience.slug }}">{{ 'newsletter.form.email'|trans }}</label>
    <input class="{{ pwNewsletterEmailInputClass|default('bg-white border-2 border-gray-100 w-full mb-4 py-2 px-4 text-gray-900 focus:outline-hidden focus:border-primary focus:ring-primary') }}" type="email" id="newsletter-email-{{ audience.slug }}"
           name="email" autocomplete="email" required>

    {# Inline rather than utility classes on purpose: a bot trap that a purged
       stylesheet or a site's CSS reset can un-hide stops being a trap. #}
    <div aria-hidden="true" style="position:absolute;left:-9999px;top:-9999px;">
        <label>{{ 'newsletter.form.honeypot'|trans }}<input type="text" name="website" tabindex="-1" autocomplete="off"></label>
    </div>

    <button class="{{ pwNewsletterSubmitClass|default('link-btn') }}" type="submit">{{ 'newsletter.form.submit'|trans }}</button>
</form>
</div>
