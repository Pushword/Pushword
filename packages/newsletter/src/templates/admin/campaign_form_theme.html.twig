{% extends '@PushwordNewsletter/admin/form_theme.html.twig' %}

{% block _Campaign_subject_row %}
  <div class="col-12">
    {{ include('@PushwordNewsletter/admin/_personalization_help.html.twig', {usage: 'campaign'}, with_context: false) }}
  </div>
  {{ block('form_row') }}
{% endblock %}

{% block _Campaign_emailLayout_widget %}
  {{ block('choice_widget') }}
  <div class="pw-campaign-design-summary" data-campaign-design-summary
    data-current="{{ 'newsletter.campaign.design.current'|trans }}"
    data-empty="{{ 'newsletter.campaign.design.empty'|trans }}"
    data-custom="{{ 'newsletter.campaign.design.custom'|trans }}"
    data-customize="{{ 'newsletter.campaign.design.customize'|trans }}"
    data-shared="{{ 'newsletter.campaign.design.shared'|trans }}"
    data-edit-audience="{{ 'newsletter.campaign.design.edit'|trans }}"
    data-audience-warning="{{ 'newsletter.campaign.design.warning'|trans }}"
    data-personal="{{ 'newsletter.campaign.design.personal'|trans }}"
    data-personal-customize="{{ 'newsletter.campaign.design.personalCustomize'|trans }}"
    data-personal-edit="{{ 'newsletter.campaign.design.personalEdit'|trans }}"
    data-personal-warning="{{ 'newsletter.campaign.design.personalWarning'|trans }}">
    <p data-campaign-design-current aria-live="polite">{{ 'newsletter.campaign.design.empty'|trans }}</p>
    <p data-campaign-design-description hidden></p>
    <details data-campaign-design-edit-details hidden>
      <summary>{{ 'newsletter.campaign.design.customize'|trans }}</summary>
      <p data-campaign-design-warning hidden></p>
      <a data-campaign-design-edit hidden target="_blank" rel="noopener"></a>
    </details>
  </div>
{% endblock %}

{% block _Campaign_smsContent_widget %}
  {% set attr = attr|merge({'aria-describedby': (attr['aria-describedby']|default('') ~ ' ' ~ id ~ '_count')|trim}) %}
  {{ block('textarea_widget') }}
  <output id="{{ id }}_count" for="{{ id }}" class="form-text pw-sms-counter" data-sms-counter data-limit="480" data-template="{{ 'newsletter.sms.characters'|trans({'%count%': '__count__'}) }}" data-too-long="{{ 'newsletter.sms.contentInvalid'|trans }}" aria-live="polite">{{ 'newsletter.sms.characters'|trans({'%count%': value|length}) }}</output>
{% endblock %}
