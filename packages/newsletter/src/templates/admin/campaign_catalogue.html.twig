{% extends '@PushwordNewsletter/admin/layout.html.twig' %}

{# Other sources' statuses display as given. #}
{% set statusLabels = {
  draft: 'newsletter.campaign.status.draft',
  scheduled: 'newsletter.campaign.status.scheduled',
  sending: 'newsletter.campaign.status.sending',
  sent: 'newsletter.campaign.status.sent',
} %}
{% set isInitialEmpty = availableCount == 0 and not hasFilters %}

{% macro creations(actions) %}
  <a class="btn btn-primary" href="{{ path('admin_newsletter_campaign_new') }}">{{ 'newsletter.catalogue.createNative'|trans }}</a>
  {% for label, url in actions %}<a class="btn btn-primary" href="{{ url }}">{{ label|trans }}</a>{% endfor %}
{% endmacro %}

{% block configured_stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ versionedAsset('/bundles/pushwordnewsletter/catalogue.css') }}">
{% endblock %}

{% block content_title %}{{ 'newsletter.campaign.label.plural'|trans }}{% endblock %}

{% block page_actions %}
  <div class="pw-catalogue-page-actions">
    {% if not isInitialEmpty %}<div class="pw-catalogue-creations">{{ _self.creations(creationActions) }}</div>{% endif %}
    <a class="pw-catalogue-manage" href="{{ path('admin_newsletter_campaign_index') }}">{{ 'newsletter.catalogue.manageNative'|trans }}</a>
  </div>
{% endblock %}

{% block main %}
  <div class="pw-catalogue">
    {% if notices is not empty %}
      <div class="pw-catalogue-notices">
        {% for source, notice in notices %}
          {% set level = noticeLevels[source]|default('info') %}
          {% set level = level in ['warning', 'danger'] ? level : 'info' %}
          <p class="pw-catalogue-notice{% if level != 'info' %} alert alert-{{ level }}{% endif %}" data-notice-level="{{ level }}" role="status"><strong>{{ source|capitalize }}</strong>: {{ notice }}</p>
        {% endfor %}
      </div>
    {% endif %}
    {% if not isInitialEmpty %}
      <form method="get" class="pw-catalogue-filters" aria-label="{{ 'newsletter.catalogue.filters'|trans }}">
        <div>
          <label class="form-label" for="campaign-source">{{ 'newsletter.catalogue.source'|trans }}</label>
          <select class="form-select" id="campaign-source" name="source">
            <option value="">{{ 'newsletter.workspace.filterAll'|trans }}</option>
            {% for value in sources %}<option value="{{ value }}"{% if source == value %} selected{% endif %}>{{ value|capitalize }}</option>{% endfor %}
          </select>
        </div>
        <div>
          <label class="form-label" for="campaign-status">{{ 'newsletter.campaign.field.status'|trans }}</label>
          <select class="form-select" id="campaign-status" name="status">
            <option value="">{{ 'newsletter.workspace.filterAll'|trans }}</option>
            {% for value in statuses %}
              <option value="{{ value }}"{% if status == value %} selected{% endif %}>{{ statusLabels[value] is defined ? statusLabels[value]|trans : value }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="pw-catalogue-search">
          <label class="form-label" for="campaign-query">{{ 'newsletter.catalogue.search'|trans }}</label>
          <div class="pw-catalogue-search-controls">
            <input class="form-control" type="search" id="campaign-query" name="q" value="{{ query }}">
            <button class="btn btn-secondary" type="submit">{{ 'newsletter.statistics.apply'|trans }}</button>
            {% if hasFilters and items is not empty %}<a href="{{ path('admin_newsletter_campaign_catalogue') }}">{{ 'newsletter.statistics.reset'|trans }}</a>{% endif %}
          </div>
        </div>
      </form>
      <div class="pw-catalogue-summary">
        <p data-campaign-results>{{ 'newsletter.catalogue.results'|trans({'%shown%': items|length|format_number, '%total%': availableCount|format_number}) }}</p>
        <p data-campaign-timezone>{{ 'newsletter.catalogue.timezone'|trans({'%timezone%': timezone}) }}</p>
      </div>
    {% endif %}
    {% if items is not empty %}
      <div class="table-responsive pw-catalogue-table-container">
        <table class="table datagrid">
          <caption class="visually-hidden">{{ 'newsletter.campaign.label.plural'|trans }}</caption>
          <thead><tr>
            <th scope="col">{{ 'newsletter.campaign.field.subject'|trans }}</th>
            <th scope="col">{{ 'newsletter.catalogue.source'|trans }}</th>
            <th scope="col">{{ 'newsletter.campaign.field.status'|trans }}</th>
            <th scope="col">{{ 'newsletter.campaign.field.scheduledAt'|trans }}</th>
            <th scope="col">{{ 'newsletter.catalogue.sentAt'|trans }}</th>
            <th scope="col">{{ 'newsletter.catalogue.actions'|trans }}</th>
          </tr></thead>
          <tbody>
            {% for item in items %}
              <tr data-campaign-key="{{ item.key }}">
                <th scope="row">
                  {% if item.actions is not empty %}
                    <a class="pw-catalogue-subject" href="{{ item.actions|first }}">{{ item.subject }}</a>
                  {% else %}
                    <span class="pw-catalogue-subject">{{ item.subject }}</span>
                  {% endif %}
                  {% if item.audience %}<span class="pw-catalogue-audience">{{ item.audience }}</span>{% endif %}
                </th>
                <td data-label="{{ 'newsletter.catalogue.source'|trans }}">{{ item.source|capitalize }}</td>
                <td data-label="{{ 'newsletter.campaign.field.status'|trans }}">{{ item.status is null ? 'newsletter.catalogue.unknown'|trans : (statusLabels[item.status] is defined ? statusLabels[item.status]|trans : item.status) }}</td>
                <td data-label="{{ 'newsletter.campaign.field.scheduledAt'|trans }}">{{ item.scheduledAt ? item.scheduledAt|format_datetime('medium', 'short', timezone: timezone) : 'newsletter.catalogue.unknown'|trans }}</td>
                <td data-label="{{ 'newsletter.catalogue.sentAt'|trans }}">{{ item.sentAt ? item.sentAt|format_datetime('medium', 'short', timezone: timezone) : 'newsletter.catalogue.unknown'|trans }}</td>
                <td data-label="{{ 'newsletter.catalogue.actions'|trans }}"><div class="pw-catalogue-row-actions">{% for label, url in item.actions %}<a class="pw-catalogue-row-link" href="{{ url }}">{{ label|trans }}</a>{% endfor %}</div></td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% else %}
      <section class="pw-catalogue-empty" data-catalogue-empty="{{ hasFilters ? 'filtered' : 'initial' }}" aria-labelledby="campaign-empty-title">
        <h2 id="campaign-empty-title">{{ (hasFilters ? 'newsletter.catalogue.noResultsTitle' : 'newsletter.catalogue.emptyTitle')|trans }}</h2>
        <p>{{ (hasFilters ? 'newsletter.catalogue.noResultsHelp' : 'newsletter.catalogue.emptyHelp')|trans }}</p>
        {% if hasFilters %}
          <a class="btn btn-secondary" href="{{ path('admin_newsletter_campaign_catalogue') }}">{{ 'newsletter.statistics.reset'|trans }}</a>
        {% else %}
          <div class="pw-catalogue-creations">{{ _self.creations(creationActions) }}</div>
        {% endif %}
      </section>
    {% endif %}
  </div>
{% endblock %}
