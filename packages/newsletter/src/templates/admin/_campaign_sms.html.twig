{% set pending_sends = sms_sends|filter(send => send.state.value == 'pending') %}
{% set tracked_sends = sms_sends|filter(send => send.state.value in ['accepted', 'sent']) %}
{% set campaign_sends = sms_sends|filter(send => not send.isTest) %}
<section class="pw-sms-review" data-campaign-sms aria-labelledby="campaign-sms-title">
  <header class="pw-sms-heading">
    <h2 id="campaign-sms-title">{{ 'newsletter.sms.alternative'|trans }}</h2>
    {% if campaign.hasSmsAlternative %}<span class="pw-sms-meta">{{ 'newsletter.sms.characters'|trans({'%count%': campaign.smsContent|length}) }}</span>{% endif %}
  </header>
  {% if not campaign.hasSmsAlternative %}
    <div class="pw-sms-empty" data-sms-empty>
      <p>{{ 'newsletter.sms.emptyHelp'|trans }}</p>
      {% if campaign.isDraft %}<a class="btn btn-secondary" href="{{ path('admin_newsletter_campaign_edit', {entityId: campaign.id}) }}#Campaign_smsContent">{{ 'newsletter.sms.addText'|trans }}</a>{% endif %}
    </div>
  {% else %}
    <p class="pw-sms-meta">{{ 'newsletter.sms.routingHelp'|trans }}</p>
    <div class="pw-sms-preview"><p>{{ campaign.smsContent }}</p></div>
    {% if not sms_enabled %}<p class="pw-sms-notice" data-sms-paused>{{ 'newsletter.sms.disabled'|trans }}</p>{% endif %}
    {% if campaign.isDraft or campaign.isScheduled %}
      {% if sms_recipients is empty %}
        {% set contact_query = campaign.audience ? {filters: {audience: {comparison: '=', value: campaign.audience.id}}} : {} %}
        <p class="pw-sms-meta" data-sms-no-recipients>{{ 'newsletter.sms.noRecipients'|trans }} <a href="{{ path('admin_newsletter_contact_index', contact_query) }}">{{ 'newsletter.sms.manageContacts'|trans }}</a></p>
      {% else %}
        <details class="pw-sms-recipients">
          <summary>{{ 'newsletter.sms.recipients'|trans({'%count%': sms_recipients|length}) }}</summary>
          <ul>
            {% for contact in sms_recipients %}
              <li><span>{{ contact.name }}</span><span class="pw-sms-meta">{{ contact.phone }}{% if contact.locale %} · {{ contact.locale }}{% endif %}</span></li>
            {% endfor %}
          </ul>
        </details>
      {% endif %}
    {% endif %}
    {% if campaign.isDraft and sms_enabled %}
      <section class="pw-sms-test" aria-labelledby="sms-test-title">
        <h3 id="sms-test-title">{{ 'newsletter.sms.testTitle'|trans }}</h3>
        <form method="post" action="{{ path('admin_newsletter_campaign_sms', {entityId: campaign.id, operation: 'test'}) }}">
          <input type="hidden" name="_token" value="{{ csrf_token('admin_action_sms_' ~ campaign.id) }}">
          <input type="hidden" name="reference" value="{{ sms_reference }}">
          <label for="sms-test-phone" class="form-label">{{ 'newsletter.sms.testPhone'|trans }}</label>
          <div class="pw-sms-test-controls">
            <input type="tel" id="sms-test-phone" name="phone" class="form-control" required pattern="\+[1-9][0-9]{7,14}" aria-describedby="sms-test-help" autocomplete="tel" placeholder="+33612345678">
            <button class="btn btn-secondary" type="submit">{{ 'newsletter.sms.test'|trans }}</button>
          </div>
          <p id="sms-test-help" class="pw-sms-meta">{{ 'newsletter.sms.testHelp'|trans }}</p>
        </form>
      </section>
    {% endif %}
  {% endif %}
  {% if sms_sends is not empty %}
    <section class="pw-sms-history" aria-labelledby="sms-history-title">
      <header class="pw-sms-heading">
        <h3 id="sms-history-title">{{ 'newsletter.sms.history'|trans }}</h3>
        {% if tracked_sends is not empty %}
          <form method="post" action="{{ path('admin_newsletter_campaign_sms', {entityId: campaign.id, operation: 'refresh'}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('admin_action_sms_' ~ campaign.id) }}">
            <button type="submit" class="btn btn-secondary">{{ 'newsletter.sms.refresh'|trans }}</button>
          </form>
        {% endif %}
      </header>
      <p class="pw-sms-meta">{{ 'newsletter.sms.deliveryHelp'|trans }}</p>
      {% if campaign_sends is not empty %}
        <dl class="pw-sms-counts" data-sms-campaign-counts>
          {% for state, count in sms_counts %}
            <div><dt>{{ ('newsletter.sms.state.' ~ state)|trans }}</dt><dd>{{ count }}</dd></div>
          {% endfor %}
        </dl>
      {% endif %}
      <ul class="pw-sms-deliveries">
        {% for send in sms_sends %}
          <li class="pw-sms-delivery" data-sms-delivery>
            <header class="pw-sms-heading">
              <div class="pw-sms-identity"><strong>{{ send.phone }}</strong>{% if send.isTest %}<span class="badge badge-secondary">{{ 'newsletter.sms.testLabel'|trans }}</span>{% endif %}</div>
              <span class="badge badge-{{ {pending: 'secondary', accepted: 'info', sent: 'info', delivered: 'success', failed: 'danger', skipped: 'secondary'}[send.state.value] }}" data-sms-state>{{ ('newsletter.sms.state.' ~ send.state.value)|trans }}</span>
            </header>
            <p class="pw-sms-delivery-text">{{ send.content }}</p>
            {% if send.error and send.state.value == 'pending' %}<p class="pw-sms-meta">{{ 'newsletter.sms.retrying'|trans }}</p>{% endif %}
            {% if send.nextAttemptAt %}<p class="pw-sms-meta">{{ 'newsletter.sms.nextAttempt'|trans }} <time datetime="{{ send.nextAttemptAt|date('c') }}">{{ send.nextAttemptAt|date('d/m/Y H:i T') }}</time></p>{% endif %}
          </li>
        {% endfor %}
      </ul>
      {% if pending_sends is not empty %}
        <details class="pw-sms-cancel">
          <summary>{{ 'newsletter.sms.cancel'|trans }}</summary>
          <p class="pw-sms-meta">{{ 'newsletter.sms.cancelHelp'|trans }}</p>
          <form method="post" action="{{ path('admin_newsletter_campaign_sms', {entityId: campaign.id, operation: 'cancel'}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('admin_action_sms_' ~ campaign.id) }}">
            <button type="submit" class="btn btn-outline-danger">{{ 'newsletter.sms.cancelConfirm'|trans }}</button>
          </form>
        </details>
      {% endif %}
    </section>
  {% endif %}
</section>
