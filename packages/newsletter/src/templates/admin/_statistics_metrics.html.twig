{% import '@PushwordNewsletter/admin/_statistics_macros.html.twig' as statistics %}
<dl class="pw-statistics-metrics">
  {% for metric in ['sent', 'clickers', 'clickRate'] %}
    <div{% if metric == 'clickRate' %} class="pw-statistics-metric-rate"{% endif %}>
      <dt>{{ ('newsletter.statistics.' ~ metric)|trans }}</dt>
      <dd data-statistic="{{ metric }}">{{ statistics.value(metric, totals[metric], totals.sent, trackingAvailable) }}</dd>
    </div>
  {% endfor %}
</dl>
<dl class="pw-statistics-secondary">
  {% for metric in ((showFeedback ?? true) ? ['clicks', 'bounced', 'unsubscribed'] : ['clicks']) %}
    <div{% if metric != 'clicks' and totals[metric] > 0 %} class="pw-statistics-attention"{% endif %}>
      <dt>{{ ('newsletter.statistics.' ~ metric)|trans }}</dt>
      <dd data-statistic="{{ metric }}">{{ statistics.value(metric, totals[metric], totals.sent, trackingAvailable) }}</dd>
    </div>
  {% endfor %}
</dl>
