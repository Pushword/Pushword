{% extends '@pwAdmin/easyadmin_layout.html.twig' %}

{% block head_metas %}
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noodp, noimageindex, notranslate, nocache">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="generator" content="EasyAdmin">
  {% guard function csp_nonce %}
    <meta name="csp-nonce" content="{{ csp_nonce('style') }}">
  {% endguard %}
{% endblock %}

{% block configured_stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ versionedAsset('/bundles/pushwordnewsletter/admin.css') }}">
{% endblock %}

{% block configured_javascripts %}
  {{ parent() }}
  <script type="module" src="{{ versionedAsset('/bundles/pushwordnewsletter/admin.js') }}"></script>
{% endblock %}

{% block body_attr %}{{ parent() }} data-newsletter{% endblock %}

{% block content_header_wrapper %}
  {{ include('@PushwordNewsletter/admin/_navigation.html.twig') }}
  {{ parent() }}
{% endblock %}

{% block content_help %}{% endblock %}
