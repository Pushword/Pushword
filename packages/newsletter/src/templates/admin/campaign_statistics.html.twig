{% extends '@PushwordNewsletter/admin/statistics_layout.html.twig' %}

{% block content_title %}{{ campaign.subject }}{% endblock %}

{% block main %}
  <div class="pw-statistics">
    <div class="pw-statistics-heading">
      <p>{{ campaign.audience }}{% if campaign.date %} · {{ campaign.date|date('d/m/Y H:i', timezone) }}{% endif %} · {{ ('newsletter.campaign.status.' ~ campaign.status)|trans }}</p>
      <a href="{{ path('admin_newsletter_statistics', backFilters) }}">{{ 'newsletter.statistics.back'|trans }}</a>
    </div>
    {{ include('@PushwordNewsletter/admin/_statistics_metrics.html.twig', {totals: campaign}) }}

    <section aria-labelledby="statistics-delivery">
      <div class="pw-statistics-heading">
        <h2 id="statistics-delivery">{{ 'newsletter.statistics.delivery'|trans }}</h2>
        <a href="{{ path('admin_newsletter_campaign_detail', {entityId: campaign.id}) }}">{{ 'newsletter.statistics.reviewCampaign'|trans }}</a>
      </div>
      <dl class="pw-statistics-list pw-statistics-delivery">
        {% for metric in ['recipients', 'sent', 'pending', 'skipped', 'failed', 'bounced'] %}
          {% set filters = {campaign: {comparison: '=', value: campaign.id}} %}
          {% if metric in ['sent', 'pending', 'skipped', 'failed', 'bounced'] %}
            {% set filters = filters|merge({state: {comparison: '=', value: metric}}) %}
          {% endif %}
          <div><dt>{% if metric == 'sent' %}{{ ('newsletter.statistics.' ~ metric)|trans }}{% else %}<a href="{{ path('admin_newsletter_campaign_recipient_index', {filters: filters}) }}">{{ ('newsletter.statistics.' ~ metric)|trans }}</a>{% endif %}</dt><dd>{{ campaign[metric]|number_format }}</dd></div>
        {% endfor %}
        {% for metric in ['bounceRate', 'unsubscribeRate'] %}
          <div><dt>{{ ('newsletter.statistics.' ~ metric)|trans }}</dt><dd>{{ campaign[metric] is null ? 'newsletter.statistics.notAvailable'|trans : campaign[metric]|number_format(2) ~ ' %' }}</dd></div>
        {% endfor %}
      </dl>
      <p class="pw-statistics-note">{{ 'newsletter.statistics.sentHelp'|trans }}</p>
    </section>

    <section aria-labelledby="statistics-links">
      <h2 id="statistics-links">{{ 'newsletter.statistics.links'|trans }}</h2>
      {% if links is empty %}
        <p class="pw-statistics-empty">{{ (campaign.tracking ? 'newsletter.statistics.noClicks' : 'newsletter.statistics.trackingDisabled')|trans }}</p>
      {% else %}
        <div class="table-responsive">
          <table class="table pw-statistics-table">
            <caption class="visually-hidden">{{ 'newsletter.statistics.links'|trans }}</caption>
            <thead><tr><th scope="col">{{ 'newsletter.statistics.url'|trans }}</th><th scope="col" class="pw-statistics-number">{{ 'newsletter.campaign.field.clicks'|trans }}</th><th scope="col" class="pw-statistics-number">{{ 'newsletter.statistics.clickers'|trans }}</th></tr></thead>
            <tbody>
              {% for link in links %}
                <tr><th scope="row" class="pw-statistics-url">{{ link.url }}</th><td class="pw-statistics-number">{{ link.clicks|number_format }}</td><td class="pw-statistics-number">{{ link.contacts|number_format }}</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}
      <p class="pw-statistics-note">{{ 'newsletter.statistics.clicksHelp'|trans }}</p>
    </section>
    <p class="pw-statistics-note">{{ 'newsletter.statistics.unmeasured'|trans }}</p>
  </div>
{% endblock %}
