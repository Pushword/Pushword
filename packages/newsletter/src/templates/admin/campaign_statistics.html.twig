{% extends '@PushwordNewsletter/admin/statistics_layout.html.twig' %}
{% import '@PushwordNewsletter/admin/_statistics_macros.html.twig' as statistics %}
{% import '@Pushword/component/context_help.html.twig' as contextHelp %}

{% block content_title %}{{ campaign.subject }}{% endblock %}
{% block page_title %}{{ 'newsletter.statistics.title'|trans }} · {{ campaign.subject }}{% endblock %}
{% block page_actions %}<a class="btn btn-outline-secondary pw-statistics-back" href="{{ path('admin_newsletter_statistics', backFilters) }}"><i class="fa fa-arrow-left" aria-hidden="true"></i> {{ 'newsletter.statistics.back'|trans }}</a>{% endblock %}

{% block main %}
  <div class="pw-statistics">
    <div class="pw-statistics-metadata pw-statistics-report-context">
      <span class="pw-statistics-status" data-state="{{ campaign.status }}">{{ ('newsletter.campaign.status.' ~ campaign.status)|trans }}</span>
      <span>{{ campaign.audience }}</span>
      {% if campaign.date %}<time datetime="{{ campaign.date|date('c', timezone) }}">{{ campaign.date|format_datetime('medium', 'short', timezone: timezone, locale: app.request.locale) }}</time>{% endif %}
    </div>
    {% if campaign.status == 'sending' %}<p class="pw-statistics-sending"><i class="fa fa-clock" aria-hidden="true"></i> {{ 'newsletter.statistics.sendingHelp'|trans }}</p>{% endif %}
    {{ include('@PushwordNewsletter/admin/_report_metrics.html.twig') }}

    <section class="pw-statistics-delivery" aria-labelledby="statistics-delivery">
      <div>
        <div class="pw-statistics-heading"><h2 id="statistics-delivery">{{ 'newsletter.statistics.delivery'|trans }}</h2><a class="pw-statistics-action" href="{{ path('admin_newsletter_campaign_detail', {entityId: campaign.id}) }}">{{ 'newsletter.statistics.reviewCampaign'|trans }}</a></div>
        <dl class="pw-statistics-list">
          {% for metric in ['recipients', 'pending', 'failed', 'skipped'] %}
            {% set filters = {campaign: {comparison: '=', value: campaign.id}} %}
            {% if metric != 'recipients' %}{% set filters = filters|merge({state: {comparison: '=', value: metric}}) %}{% endif %}
            <div class="pw-statistics-linked-row{% if metric == 'failed' and campaign.failed > 0 %} pw-statistics-failure{% elseif metric == 'pending' and campaign.pending > 0 %} pw-statistics-pending{% endif %}">
              <dt><a href="{{ path('admin_newsletter_campaign_recipient_index', {filters: filters}) }}">{{ ('newsletter.statistics.' ~ metric)|trans }}</a></dt>
              <dd{% if campaign[metric] == 0 %} class="pw-statistics-quiet"{% endif %}>{{ campaign[metric]|format_number(locale: app.request.locale) }} <i class="fa fa-angle-right" aria-hidden="true"></i></dd>
            </div>
          {% endfor %}
        </dl>
      </div>
      <div>
        <h2>{{ 'newsletter.statistics.feedback'|trans }} {{ contextHelp.help('newsletter.statistics.feedback'|trans, 'newsletter.statistics.feedbackHelp'|trans) }}</h2>
        <p class="pw-statistics-note">{{ 'newsletterHelpRates'|trans }}</p>
        <dl class="pw-statistics-list pw-statistics-quality">
          {% for metric, rate in {bounced: 'bounceRate', unsubscribed: 'unsubscribeRate'} %}
            <div>
              <dt>{% if metric == 'bounced' %}<a class="pw-statistics-action" href="{{ path('admin_newsletter_campaign_recipient_index', {filters: {campaign: {comparison: '=', value: campaign.id}, state: {comparison: '=', value: metric}}}) }}">{{ ('newsletter.statistics.' ~ metric)|trans }}</a>{% else %}{{ ('newsletter.statistics.' ~ metric)|trans }}{% endif %}</dt>
              <dd><strong>{{ statistics.fraction(report.rate(rate)) }}</strong><small>{{ statistics.measure(report.metric(metric)) }} {{ 'newsletter.statistics.contactPlural'|trans }}</small></dd>
            </div>
          {% endfor %}
        </dl>
      </div>
    </section>

    <section aria-labelledby="statistics-links">
      <h2 id="statistics-links">{{ 'newsletter.statistics.links'|trans }} {{ contextHelp.help('newsletter.statistics.links'|trans, 'newsletter.statistics.linksSummary'|trans) }}</h2>
      {% if links is empty %}
        {% if campaign.sent == 0 %}
          {% set emptyTitle = 'newsletter.statistics.noSends' %}
        {% elseif report.metric('clicks').state != 'measured' %}
          {% set emptyTitle = 'newsletter.statistics.' ~ report.metric('clicks').state %}
        {% elseif trackingAvailable %}
          {% set emptyTitle = 'newsletter.statistics.noClicks' %}
        {% else %}
          {% set emptyTitle = 'newsletter.statistics.notAvailable' %}
        {% endif %}
        {% set emptyHelp = trackingAvailable ? 'newsletter.statistics.noClicksHelp' : 'newsletter.statistics.trackingDisabled' %}
        {% if report.metric('clicks').state == 'unavailable' %}{% set emptyHelp = 'newsletter.statistics.campaignMethodology' %}{% endif %}
        <div class="pw-statistics-empty pw-statistics-links-empty">
          <h3>{{ emptyTitle|trans }}</h3>
          <p>{{ emptyHelp|trans }}</p>
          {% if not trackingAvailable and campaign.audienceId %}<a class="pw-statistics-action" href="{{ path('admin_newsletter_audience_edit', {entityId: campaign.audienceId}) }}">{{ 'newsletter.statistics.audienceSettings'|trans }}</a>{% endif %}
        </div>
      {% else %}
        <table class="table pw-statistics-table pw-statistics-links" role="table">
          <caption class="visually-hidden">{{ 'newsletter.statistics.links'|trans }}</caption>
          <thead role="rowgroup"><tr role="row"><th scope="col" role="columnheader">{{ 'newsletter.statistics.url'|trans }}</th><th scope="col" role="columnheader" class="pw-statistics-number">{{ 'newsletter.statistics.clickers'|trans }}</th><th scope="col" role="columnheader" class="pw-statistics-number">{{ 'newsletter.campaign.field.clicks'|trans }}</th></tr></thead>
          <tbody role="rowgroup">
            {% for link in links %}
              <tr role="row">
                <th scope="row" role="rowheader" class="pw-statistics-url">
                  <a href="{{ link.url }}" target="_blank" rel="noopener noreferrer">{{ link.host }}{{ link.path }} <i class="fa fa-arrow-up-right-from-square" aria-hidden="true"></i><span class="visually-hidden"> {{ 'newsletter.statistics.opensNewTab'|trans }}</span></a>
                  <code>{{ link.url }}</code>
                </th>
                <td role="cell" class="pw-statistics-number"><span class="pw-statistics-mobile-label" aria-hidden="true">{{ 'newsletter.statistics.clickers'|trans }}</span><div class="pw-statistics-rate"><meter min="0" max="{{ maxLinkContacts }}" value="{{ link.contacts }}" aria-label="{{ 'newsletter.statistics.clickers'|trans }}">{{ link.contacts }}</meter><strong>{{ link.contacts|format_number(locale: app.request.locale) }}</strong></div></td>
                <td role="cell" class="pw-statistics-number"><span class="pw-statistics-mobile-label" aria-hidden="true">{{ 'newsletter.campaign.field.clicks'|trans }}</span>{{ link.clicks|format_number(locale: app.request.locale) }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      {% endif %}
    </section>
    {{ include('@PushwordNewsletter/admin/_report_comparison.html.twig') }}
    {{ include('@PushwordNewsletter/admin/_statistics_methodology.html.twig', {isCampaign: true}) }}
  </div>
{% endblock %}
