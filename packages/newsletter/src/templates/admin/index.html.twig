{% extends '@pwAdmin/crud/index.html.twig' %}

{% set isFiltered = ea.search.query|default('')|trim is not empty or app.request.query.all('filters') is not empty %}
{% set isInitialEmpty = entities is empty and not isFiltered %}

{% block global_actions %}
  {% if not isInitialEmpty %}{{ parent() }}{% endif %}
{% endblock %}

{% block main %}
  {% set section = ea.crud.entityFqcn|split('\\')|last|lower %}
  <p class="pw-newsletter-description">{{ ('newsletter.workspace.' ~ section ~ 'Description')|trans }}</p>
  {% if section in ['automation', 'campaign'] and not isInitialEmpty %}
    {{ include('@PushwordNewsletter/admin/_status_filters.html.twig') }}
  {% endif %}
  {% set hasSiteTemplates = section == 'emailtemplate' and site_templates|default([]) is not empty %}
  <div{% if hasSiteTemplates %} class="pw-newsletter-template-library"{% endif %}>
    <div data-pw-newsletter-index data-select-all="{{ 'newsletter.workspace.selectAll'|trans }}" data-select-row="{{ 'newsletter.workspace.selectRow'|trans }}" data-row-actions="{{ 'newsletter.workspace.rowActions'|trans }}">
      {% if hasSiteTemplates %}<h2>{{ 'newsletter.template.savedGroup'|trans }}</h2>{% endif %}
      {{ parent() }}
    </div>
    {% if hasSiteTemplates %}
      <section class="pw-newsletter-site-templates" aria-labelledby="newsletter-site-templates">
        <h2 id="newsletter-site-templates">{{ 'newsletter.template.siteGroup'|trans }}</h2>
        <p class="form-text">{{ 'newsletter.template.siteHelp'|trans }}</p>
        <ul>
          {% for label, layout in site_templates %}
            <li><strong>{{ label }}</strong><a href="{{ path('admin_newsletter_site_template_preview', {name: layout|slice(5)}) }}">{{ 'newsletter.template.preview'|trans }}<span class="visually-hidden"> {{ label }}</span></a></li>
          {% endfor %}
        </ul>
      </section>
    {% endif %}
  </div>
{% endblock %}

{% block table_body_empty %}
  {% set isFiltered = ea.search.query|default('')|trim is not empty or app.request.query.all('filters') is not empty %}
  {% if isFiltered %}
    {{ parent() }}
  {% else %}
    {% set section = ea.crud.entityFqcn|split('\\')|last|lower %}
    {% set newAction = global_actions|filter(action => action.name in ['new', 'optIn'])|first %}
    <tr class="no-results">
      <td colspan="100">
        <div class="pw-empty-state pw-newsletter-empty">
          <i class="fa {{ section == 'automation' ? 'fa-bolt' : 'fa-envelope-open-text' }} pw-empty-state__icon" aria-hidden="true"></i>
          <h2>{{ ('newsletter.workspace.' ~ section ~ 'EmptyTitle')|trans }}</h2>
          <p>{{ ('newsletter.workspace.' ~ section ~ 'EmptyHint')|trans }}</p>
          {% if newAction %}
            <a class="btn btn-primary" href="{{ newAction.linkUrl }}">{{ newAction.label|trans }}</a>
          {% elseif section == 'automationdelivery' %}
            <a class="btn btn-secondary" href="{{ path('admin_newsletter_automation_index') }}">{{ 'newsletter.automation.label.plural'|trans }}</a>
          {% endif %}
        </div>
      </td>
    </tr>
  {% endif %}
{% endblock %}
