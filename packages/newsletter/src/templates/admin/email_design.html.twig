{% extends ea().templatePath('layout') %}
{% import '@Pushword/component/context_help.html.twig' as contextHelp %}
{% form_theme design_form '@pwAdmin/form/admin_form_theme.html.twig' _self %}

{% block radio_widget %}
  <input type="radio" {{ block('widget_attributes') }} value="{{ value }}"{% if checked %} checked="checked"{% endif %}>
{% endblock %}

{% macro layoutOption(choice) %}
  {% set kind = choice.vars.value starts with 'twig:' or choice.vars.value starts with 'saved:' ? 'preset' : choice.vars.value %}
  <label class="pw-newsletter-layout-option" for="{{ choice.vars.id }}">
    {{ form_widget(choice, {attr: {class: 'form-check-input'}}) }}
    <span><strong>{{ choice.vars.label|trans }}</strong>{% if kind == 'personal' %}<span class="pw-newsletter-layout-description">{{ ('newsletter.design.' ~ kind ~ 'Help')|trans }}</span>{% endif %}</span>
    <span class="pw-newsletter-layout-thumbnail" data-layout="{{ kind }}" aria-hidden="true"><span><b></b><i></i><i></i><small></small></span></span>
  </label>
{% endmacro %}

{% block content_title %}{{ 'newsletter.design.title'|trans }}{% endblock %}

{% block page_actions %}
  <a class="btn btn-secondary" href="{{ path('admin_newsletter_audience_edit', {entityId: audience.id}) }}">{{ 'newsletter.design.back'|trans }}</a>
  <button type="submit" form="newsletter-design-form" class="btn btn-primary">{{ 'newsletter.design.save'|trans }}</button>
{% endblock %}

{% block main %}
  <div class="pw-newsletter-design-context">
    <strong>{{ audience.name }} {{ contextHelp.help('newsletter.design.title'|trans, 'newsletter.design.description'|trans) }}</strong><span>{{ site_name }}</span>
  </div>
  <div class="pw-newsletter-design" data-pw-email-preview data-viewport="mobile" data-mobile-panel="settings" data-saved-values="{{ [audience.emailLayout, audience.headerMarkdown, audience.footerMarkdown, audience.signatureMarkdown]|json_encode }}">
    <div class="pw-newsletter-design-switch" role="group" aria-label="{{ 'newsletter.design.view'|trans }}">
      <button type="button" class="btn btn-secondary" data-design-panel="settings" aria-controls="newsletter-design-settings" aria-pressed="true">{{ 'newsletter.design.settings'|trans }}</button>
      <button type="button" class="btn btn-secondary" data-design-panel="preview" aria-controls="newsletter-design-preview" aria-pressed="false">{{ 'newsletter.design.preview'|trans }}</button>
    </div>
    <div id="newsletter-design-settings" class="pw-newsletter-design-editor">
      {{ form_start(design_form, {attr: {id: 'newsletter-design-form'}}) }}
        {{ form_errors(design_form) }}
        <fieldset class="pw-newsletter-design-layout">
          {% set layoutHelp %}<p>{{ 'newsletter.design.simpleHelp'|trans }}</p><p>{{ 'newsletter.design.framedHelp'|trans }}</p>{% endset %}
          <legend>{{ design_form.emailLayout.vars.label|trans }} {{ contextHelp.help(design_form.emailLayout.vars.label|trans, layoutHelp) }}</legend>
          {% for choice in design_form.emailLayout %}
            {% if not (choice.vars.value starts with 'twig:' or choice.vars.value starts with 'saved:') %}
              {{ _self.layoutOption(choice) }}
            {% endif %}
          {% endfor %}
          {% set presets = design_form.emailLayout|filter(choice => choice.vars.value starts with 'twig:' or choice.vars.value starts with 'saved:') %}
          {% if presets|length %}
            <details class="pw-newsletter-design-presets" data-email-presets{% if design_form.emailLayout.vars.value starts with 'twig:' or design_form.emailLayout.vars.value starts with 'saved:' %} open{% endif %}>
              <summary>{{ 'newsletter.design.otherTemplates'|trans }}</summary>
              {% for choice in presets %}
                {{ _self.layoutOption(choice) }}
              {% endfor %}
            </details>
          {% endif %}
          {{ form_errors(design_form.emailLayout) }}
        </fieldset>
        <p class="pw-newsletter-design-preset" data-email-template-help{% if audience.emailTemplate is null %} hidden{% endif %}><i class="fa fa-lock" aria-hidden="true"></i> {{ 'newsletter.design.templateHelp'|trans }}</p>
        <fieldset class="pw-newsletter-design-identity" data-email-editable{% if audience.emailTemplate is not null or audience.emailPersonal %} hidden{% endif %}>
          {% set tokenHelp %}{{ 'newsletter.design.tokens'|trans }} <code>%siteName%</code> = {{ site_name }} · <code>%year%</code> = {{ 'now'|date('Y') }}{% endset %}
          <legend>{{ 'newsletter.design.identity'|trans }} {{ contextHelp.help('newsletter.design.identity'|trans, tokenHelp) }}</legend>
          {{ form_row(design_form.headerMarkdown) }}
          {{ form_row(design_form.footerMarkdown) }}
          <button type="button" class="btn btn-link" data-design-defaults data-header="{{ default_header }}" data-footer="{{ default_footer }}">{{ 'newsletter.design.defaults'|trans }}</button>
        </fieldset>
        <details class="pw-newsletter-design-signature" data-email-personal{% if audience.emailPersonal %} open{% endif %}>
          <summary>{{ 'newsletter.design.personalSignature'|trans }}</summary>
          {{ form_row(design_form.signatureMarkdown, {label_attr: {class: 'visually-hidden'}}) }}
        </details>
        <details class="pw-newsletter-design-sample">
          <summary>{{ 'newsletter.design.sample'|trans }}</summary>
          {{ form_row(design_form.sampleBody, {label_attr: {class: 'visually-hidden'}}) }}
        </details>
        <div class="pw-newsletter-design-save">
          <span role="status" aria-live="polite" data-save-state data-saved="{{ 'newsletter.design.savedState'|trans }}" data-unsaved="{{ 'newsletter.design.unsaved'|trans }}">{{ 'newsletter.design.savedState'|trans }}</span>
          <button type="submit" class="btn btn-primary">{{ 'newsletter.design.save'|trans }}</button>
        </div>
      {{ form_end(design_form) }}
    </div>
    {{ include('@PushwordNewsletter/admin/_email_preview.html.twig') }}
  </div>
{% endblock %}
