{% extends ea().templatePath('layout') %}
{% form_theme design_form '@pwAdmin/form/admin_form_theme.html.twig' %}

{% block content_title %}{{ 'newsletter.design.title'|trans }}{% endblock %}

{% block page_actions %}
  <button type="submit" form="newsletter-design-form" class="btn btn-primary">{{ 'newsletter.design.save'|trans }}</button>
{% endblock %}

{% block main %}
  <p class="pw-newsletter-description">{{ 'newsletter.design.description'|trans({'%audience%': audience.name}) }}</p>
  <div class="pw-newsletter-design" data-pw-email-preview data-viewport="mobile">
    <div>
      {{ form_start(design_form, {attr: {id: 'newsletter-design-form'}}) }}
        {{ form_errors(design_form) }}
        <fieldset class="pw-newsletter-design-layout">
          <legend>{{ design_form.emailLayout.vars.label|trans }}</legend>
          {{ form_widget(design_form.emailLayout) }}
          {{ form_help(design_form.emailLayout) }}
          {{ form_errors(design_form.emailLayout) }}
        </fieldset>
        <p class="form-text" data-email-template-help{% if audience.emailTemplate is null %} hidden{% endif %}>{{ 'newsletter.design.templateHelp'|trans }}</p>
        <div data-email-editable{% if audience.emailTemplate is not null %} hidden{% endif %}>
          {{ form_row(design_form.headerMarkdown) }}
          {{ form_row(design_form.footerMarkdown) }}
        </div>
        <details class="pw-newsletter-design-sample">
          <summary>{{ 'newsletter.design.sample'|trans }}</summary>
          {{ form_row(design_form.sampleBody, {label_attr: {class: 'visually-hidden'}}) }}
        </details>
      {{ form_end(design_form) }}
    </div>
    <section class="pw-newsletter-design-preview" aria-labelledby="newsletter-preview-title">
      <div class="pw-newsletter-design-toolbar">
        <h2 id="newsletter-preview-title">{{ 'newsletter.design.preview'|trans }}</h2>
        <div class="btn-group" role="group" aria-label="{{ 'newsletter.design.viewport'|trans }}">
          <button type="button" class="btn btn-secondary" data-preview-width="desktop" aria-pressed="false">{{ 'newsletter.design.desktop'|trans }}</button>
          <button type="button" class="btn btn-secondary" data-preview-width="mobile" aria-pressed="true">{{ 'newsletter.design.mobile'|trans }}</button>
        </div>
      </div>
      <p class="pw-newsletter-design-status" role="status" aria-live="polite" data-updating="{{ 'newsletter.design.updating'|trans }}" data-ready="{{ 'newsletter.design.ready'|trans }}" data-failed="{{ 'newsletter.design.failed'|trans }}">{{ 'newsletter.design.ready'|trans }}</p>
      <div class="pw-newsletter-design-canvas">
        <iframe title="{{ 'newsletter.design.preview'|trans }}" sandbox="" srcdoc="{{ preview_html }}"></iframe>
      </div>
      <p class="form-text">{{ 'newsletter.design.previewHelp'|trans }}</p>
    </section>
  </div>
{% endblock %}
