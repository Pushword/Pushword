{% import '@Pushword/component/context_help.html.twig' as contextHelp %}
{% set preview_id = preview_id|default('newsletter-design-preview') %}
{% set preview_viewport = preview_viewport|default('mobile') %}
<section id="{{ preview_id }}" class="pw-newsletter-design-preview" aria-labelledby="{{ preview_id }}-title">
  <div class="pw-newsletter-design-toolbar">
    <h2 id="{{ preview_id }}-title">{{ 'newsletter.design.preview'|trans }} {{ contextHelp.help('newsletter.design.preview'|trans, 'newsletter.design.previewHelp'|trans) }}</h2>
    <div class="btn-group" role="group" aria-label="{{ 'newsletter.design.viewport'|trans }}">
      <button type="button" class="btn btn-secondary" data-preview-width="mobile" aria-pressed="{{ preview_viewport == 'mobile' ? 'true' : 'false' }}">{{ 'newsletter.design.mobile'|trans }} <span>375</span></button>
      <button type="button" class="btn btn-secondary" data-preview-width="desktop" aria-pressed="{{ preview_viewport == 'desktop' ? 'true' : 'false' }}">{{ 'newsletter.design.desktop'|trans }} <span>600</span></button>
    </div>
  </div>
  <div class="pw-newsletter-design-feedback">
    <p class="pw-newsletter-design-status" role="status" aria-live="polite" data-preview-status data-state="{{ preview_html|default('') ? 'ready' : 'updating' }}" data-empty="{{ 'newsletter.campaign.design.empty'|trans }}" data-updating="{{ 'newsletter.design.updating'|trans }}" data-ready="{{ 'newsletter.design.ready'|trans }}" data-failed="{{ 'newsletter.design.failed'|trans }}">{{ (preview_html|default('') ? 'newsletter.design.ready' : 'newsletter.design.updating')|trans }}</p>
    <button type="button" class="btn btn-link" data-preview-retry hidden>{{ 'newsletter.design.retry'|trans }}</button>
  </div>
  <div class="pw-newsletter-design-canvas" tabindex="0" role="region" aria-label="{{ 'newsletter.design.canvas'|trans }}">
    <iframe title="{{ 'newsletter.design.preview'|trans }}" sandbox="{{ preview_sandbox|default('') }}" srcdoc="{{ preview_html|default('') }}"></iframe>
  </div>
</section>
