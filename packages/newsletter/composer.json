{
  "name": "pushword/newsletter",
  "type": "symfony-bundle",
  "description": "Newsletter for Pushword CMS: audiences, contacts with custom properties, segmented campaigns, criteria-driven automations and content-triggered mailings.",
  "keywords": ["newsletter", "email-marketing", "mailing-list", "campaign", "double-opt-in", "automation", "symfony", "pushword"],
  "homepage": "https://pushword.piedweb.com/extension/newsletter",
  "license": "MIT",
  "support": {
    "issues": "https://github.com/Pushword/Pushword/issues",
    "source": "https://github.com/Pushword/Pushword/tree/main/packages/newsletter",
    "docs": "https://pushword.piedweb.com/extension/newsletter"
  },
  "require": {
    "cocur/slugify": "^4.6",
    "pushword/core": "*"
  },
  "extra": {
    "branch-alias": {
      "dev-main": "1.0.x-dev"
    }
  },
  "autoload": {
    "psr-4": {
      "Pushword\\Newsletter\\": "src"
    }
  },
  "authors": [
    {
      "name": "Robin@PiedWeb",
      "email": "contact@piedweb.com",
      "homepage": "https://piedweb.com"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true
}
