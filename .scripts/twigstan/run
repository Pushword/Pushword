#!/usr/bin/env bash
set -euo pipefail

tool_dir="$(cd "$(dirname "$0")" && pwd)"
repo_dir="$(cd "$tool_dir/../.." && pwd)"
cd "$repo_dir"

configuration="$tool_dir/twigstan.php"
coverage=()
if [[ "${1:-}" == "--ci" ]]; then
    configuration="$tool_dir/ci.php"
    coverage=(--check-coverage)
    shift
fi

exec php "$repo_dir/packages/twigstan/bin/pushword-twigstan" --configuration="$configuration" "${coverage[@]}" "$@"
