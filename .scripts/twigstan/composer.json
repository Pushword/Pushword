{
  "name": "pushword/twigstan-tools",
  "description": "Isolated TwigStan tooling with temporary upstream fixes.",
  "type": "project",
  "license": "MIT",
  "require-dev": {
    "cweagans/composer-patches": "^2.0",
    "phpstan/phpstan": "2.3.5",
