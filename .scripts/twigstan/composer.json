          }
        },
        {
          "description": "Temporary fix for twigstan/twigstan#329",
          "url": "patches/329-null-coalesce.patch",
          "sha256": "79be5522cb69df000ad0a499980f311fe726f7c846bd476f69a65b1e99287ab1",
          "extra": {
            "issue-tracker-url": "https://github.com/twigstan/twigstan/issues/329"
          }
        }
      ]
    }
  },
  "scripts": {
