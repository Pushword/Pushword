#!/bin/bash -e

if ! git diff-index --quiet HEAD -- || [ -n "$(git ls-files --others --exclude-standard)" ]; then
    echo 'Commit all changes before running composer docs.' >&2
    exit 1
fi

revision=$(git rev-parse HEAD)
remote=$(git remote get-url origin)
repo_root=$(pwd)
build_root=$(mktemp -d)
mkdir -p "$build_root/tmp"
export TMPDIR="$build_root/tmp"

cleanup() {
    cd "$repo_root"
    git worktree remove --force "$build_root/source" 2>/dev/null || true
    rm -rf "$build_root"
}
trap cleanup EXIT

git worktree add --detach "$build_root/source" "$revision"
cp -a vendor "$build_root/source/vendor"

cd "$build_root/source"
composer reset-dev-app >/dev/null

cd packages/dev-app
php bin/console pw:flat:sync pushword.piedweb.com --mode=import --format=text
php bin/console pw:static pushword.piedweb.com --format=text
cd ../..

test -f docs/index.html
test -f docs/404.html
grep -q '<section id="title"' docs/editor.html
grep -qx 'pushword.piedweb.com' docs/CNAME
pages=$(find docs -name '*.html' | wc -l)
echo "$pages pages generated"
[ "$pages" -ge 100 ]

publish_dir="$build_root/publish"
mkdir -p "$publish_dir/docs"
cp -a docs/. "$publish_dir/docs/"
git -C "$publish_dir" init -q -b docs
git -C "$publish_dir" config user.name "$(git config user.name)"
git -C "$publish_dir" config user.email "$(git config user.email)"
git -C "$publish_dir" add docs
git -C "$publish_dir" commit -q -m "docs: build $revision"
git -C "$publish_dir" push --force "$remote" docs
