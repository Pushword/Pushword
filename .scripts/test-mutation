#!/usr/bin/env bash
set -euo pipefail

cd -P "$(dirname "$0")/.."

if [[ $# -lt 2 || ! -f "$1" ]]; then
    echo "Usage: ./.scripts/test-mutation <source.php> <test.php> [<test.php> ...]" >&2
    exit 2
fi

source_file=$(realpath -- "$1")
shift
if [[ "$source_file" != "$PWD"/packages/*/src/*.php ]]; then
    echo "Select a PHP source file in packages/*/src." >&2
    exit 2
fi

test_files=()
for path in "$@"; do
    if ! test_file=$(realpath -e -- "$path") || [[ ! -f "$test_file" || "$test_file" != "$PWD"/packages/*/tests/*.php ]]; then
        echo "Select a PHPUnit test file in packages/*/tests: $path" >&2
        exit 2
    fi
    test_files+=("$test_file")
done

if ! php -r 'exit(extension_loaded("pcov") ? 0 : 1);'; then
    echo "PCOV is required for mutation testing. Install php-pecl-pcov or php-pcov." >&2
    exit 1
fi

version=0.35.12
sha256=b7e9a28e23daf8178c80bb768bc3fd12047e92ef16ea5724af432314a4c01964
phar="$PWD/.infection/infection-$version.phar"
mkdir -p .infection
run_dir=$(mktemp -d "$PWD/.infection/run.XXXXXX")
trap 'rm -rf -- "$run_dir"' EXIT

verify_phar() {
    if ! printf '%s  %s\n' "$sha256" "$1" | sha256sum --check --status; then
        echo "Infection PHAR checksum mismatch at $1." >&2
        exit 1
    fi
}

if [[ -f "$phar" ]]; then
    verify_phar "$phar"
else
    curl --fail --silent --show-error --location \
        "https://github.com/infection/infection/releases/download/$version/infection.phar" \
        -o "$run_dir/infection.phar"
    verify_phar "$run_dir/infection.phar"
    mv -- "$run_dir/infection.phar" "$phar"
fi

# Keep the test database, generated PHPUnit configs and Symfony cache local to the run.
export TMPDIR="$run_dir" TEST_RUN_ID="mutation-${run_dir##*.}" XDEBUG_MODE=off
unset PUSHWORD_TEST_DATABASE_BASE_URL PUSHWORD_TEST_MYSQL_URL

php -r '
echo json_encode([
    "source" => ["directories" => [dirname($argv[1])]],
    "phpUnit" => ["configDir" => getcwd()],
    "initialTestsPhpOptions" => "-d pcov.enabled=1",
], JSON_THROW_ON_ERROR);
' "$source_file" > "$run_dir/infection.json"

php "$phar" run --configuration="$run_dir/infection.json" \
    --no-interaction --no-progress --threads=1 \
    --with-uncovered --with-timeouts -- "$source_file" "${test_files[@]}"
