#!/bin/bash -e

set -e

# Colors
GREEN='\033[0;32m'
RED='\033[0;31m'
NC='\033[0m'

cd "$(git rev-parse --show-toplevel)"

# Check gh CLI is available
if ! command -v gh &> /dev/null; then
    echo -e "${RED}Error: gh CLI is required. Install it: https://cli.github.com/${NC}"
    exit 1
fi

# Get latest tag and bump RC number
LATEST_TAG=$(git tag -l '1.0.0-rc*' | sort -V | tail -1)
if [ -z "$LATEST_TAG" ]; then
    echo -e "${RED}Error: No 1.0.0-rc* tag found${NC}"
    exit 1
fi

CURRENT_RC=$(echo "$LATEST_TAG" | sed 's/1.0.0-rc//')
NEXT_RC=$((CURRENT_RC + 1))
NEW_TAG="1.0.0-rc$NEXT_RC"

echo -e "${GREEN}Creating release $NEW_TAG (previous: $LATEST_TAG)${NC}"

# The note is promoted from the working tree into the tag. Releasing it while it is still
# uncommitted ships a note describing code the tag does not contain — which is what
# happens when a parallel agent is mid-change. Its note belongs in the same commit as its
# change, so a dirty note means that change has not landed yet.
NOTE_DRAFT="packages/docs/content/upgrade/next-release.md"
if ! git diff --quiet -- "$NOTE_DRAFT" || ! git diff --cached --quiet -- "$NOTE_DRAFT"; then
    echo -e "${RED}Error: $NOTE_DRAFT has uncommitted changes.${NC}"
    echo "Commit the upgrade note with the change it documents, then release:"
    echo "    git commit --only -m \"...\" -- <your files> $NOTE_DRAFT"
    exit 1
fi

# Promote the drafted upgrade note to rc<N> and index it, before the tag is cut
set +e
php ./.scripts/release-upgrade-note "$NEW_TAG"
NOTE_STATUS=$?
set -e
if [ "$NOTE_STATUS" -eq 10 ]; then
    NOTE="packages/docs/content/upgrade/rc$NEXT_RC.md"
    git add "$NOTE"
    git commit --only -m "docs: upgrade note for $NEW_TAG" -- \
        "$NOTE" packages/docs/content/upgrade/next-release.md packages/docs/content/upgrade.md
elif [ "$NOTE_STATUS" -ne 0 ]; then
    exit "$NOTE_STATUS"
fi

# Push commits and create/push tag
git push
git tag "$NEW_TAG"
git push origin "$NEW_TAG"

# Build release notes from commit log
NOTES=$(git log "$LATEST_TAG".."$NEW_TAG" --pretty=format:"- %s" --reverse)
if [ -z "$NOTES" ]; then
    NOTES="No changes"
fi

# Create GitHub Release
gh release create "$NEW_TAG" --title "$NEW_TAG" --notes "$NOTES"

echo -e "${GREEN}Release $NEW_TAG created: $(gh release view "$NEW_TAG" --json url -q .url)${NC}"
